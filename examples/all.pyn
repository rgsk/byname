# Every way to use byname. Run: uv run byname run examples/all.pyn
# See the plain Python:       uv run byname show examples/all.pyn
#
# One rule for all forms: in `field=value`, the left is the field/param name, the right is the
# local value. A bare `field=` means `field=field`.

from dataclasses import dataclass
from typing import overload

name = "Rahul"
age = 26


# ============================================================================
# 1. CALLS: pass locals by name
# ============================================================================


def greet(*, name: str, age: int, loud: bool = False) -> str:
    s = f"{name} is {age}"
    return s.upper() if loud else s


assert greet(name=, age=) == "Rahul is 26"  # name=name, age=age
assert greet(name=, age=age + 1) == "Rahul is 27"  # mix shorthand and explicit
assert greet(name=, age=, loud=True) == "RAHUL IS 26"

opts = {"loud": True}
assert greet(name=, age=, **opts) == "RAHUL IS 26"  # with **kwargs


def tag(prefix: str, *, name: str) -> str:
    return f"{prefix}:{name}"


assert tag("user", name=) == "user:Rahul"  # after positional args


class Greeter:
    def hello(self, *, name: str) -> str:
        return f"hello {name}"


assert Greeter().hello(name=) == "hello Rahul"  # method calls
assert dict(name=, age=) == {"name": "Rahul", "age": 26}  # builtins: dict(name=, age=) is a dict


# ============================================================================
# 2. RECORDS: build a value from locals by name
# ============================================================================


def make(*, name: str, age: int):
    greeting = f"hi {name}"
    return (name=, age=, greeting=)  # return locals by name


p = make(name=, age=)
assert p.name == "Rahul" and p.greeting == "hi Rahul"  # attribute access

r = (name=, score=99.5)  # explicit values
r = (name=name.upper(), score=10 * 9)  # any expression
one = (name=)  # single field, no trailing comma needed
assert one.name == "Rahul"

multi = (
    name=,
    age=,  # trailing comma, multi-line
)

# records are read by name, never by position (`n, a, g = p` is a checker error), so field order never matters:
assert p == make(name="Rahul", age=26)  # equality by value: the same fields, the same values
assert p == (greeting="hi Rahul", age=26, name="Rahul")  # in any order
assert p._asdict() == {"name": "Rahul", "age": 26, "greeting": "hi Rahul"}
older = p._replace(age=27)  # copy with a change
assert older.age == 27 and p.age == 26
assert greet(**multi._asdict()) == "Rahul is 26"  # record -> keyword args

# records nest, and appear anywhere an expression can
nested = (user=(name=, age=), ok=True)
assert nested.user.name == "Rahul"
rows = [(i=, sq=i * i) for i in range(3)]  # in comprehensions
assert rows[2].sq == 4
pair = lambda x: (x=, double=x * 2)  # in lambdas
assert pair(5).double == 10
print((name=, age=))  # as a call argument


# ============================================================================
# 3. DESTRUCTURING: bind fields to locals by name
# ============================================================================

(name=, greeting=, age=) = make(name="Joker", age=99)  # any order
assert (name, age, greeting) == ("Joker", 99, "hi Joker")

(greeting=) = make(name="Bob", age=1)  # any subset
assert greeting == "hi Bob"

(name=who, age=years) = make(name="Ann", age=30)  # rename: who = .name, years = .age
assert (who, years) == ("Ann", 30)

(name=, name=alias) = make(name="Cy", age=2)  # same field into two locals
assert name == alias == "Cy"

d = {}


class Box:
    label: str = ""


box = Box()
(name=box.label, age=d["age"]) = make(name="Dee", age=4)  # into attributes and subscripts
assert box.label == "Dee" and d == {"age": 4}

(
    name=,
    greeting=,  # multi-line target
) = make(name="Eve", age=5)
assert name == "Eve"

(name=) = p; (age=) = p  # several on one line with ; (fmt: skip keeps ruff from splitting it)  # fmt: skip
assert (name, age) == ("Rahul", 26)

a, b = 1, 2
(a=b, b=a) = (a=, b=)  # swap via rename
assert (a, b) == (2, 1)

# destructuring is plain attribute access, so it works on ANY object:
(real=re, imag=im) = 3 + 4j  # builtins
assert (re, im) == (3.0, 4.0)


@dataclass
class User:
    name: str
    email: str


(email=) = User("Fay", "fay@x.com")  # dataclasses
assert email == "fay@x.com"

import os

(sep=, curdir=) = os  # even modules
assert curdir == "."


class Point:
    def __init__(self, x: int, y: int):
        (x=self.x, y=self.y) = (x=, y=)  # assign many attrs at once

    def norm2(self) -> int:
        (x=, y=) = self  # unpack self
        return x * x + y * y


assert Point(3, 4).norm2() == 25

pts = [(x=1, y=2), (x=3, y=4)]
for (x=, y=yy) in pts:  # in for-loop targets: each item destructured
    assert yy == x + 1
assert [x * y for (x=, y=) in pts] == [2, 12]  # and in comprehensions

(ok=, user=(name=n_, age=)) = nested  # nested: reads through nested.user
assert (ok, n_, age) == (True, "Rahul", 26)

# record types: written the way hover shows them. Exact field set, any field order
type Person = (name: str, age: int)
someone: Person = (age=30, name="Gil")  # order differs from the type: fine
assert someone.name == "Gil"


def oldest(people: list[Person]) -> Person:
    return max(people, key=lambda p: p.age)


assert oldest([someone, (name="Hal", age=40)]).name == "Hal"


def intro(person: Person, loud: bool = False) -> str:  # destructure a parameter: name it, unpack it first
    (name=, age=) = person
    if loud:
        return f"{name.upper()}, {age}!"
    return f"{name}, {age}"


assert intro(someone) == "Gil, 30" and intro(person=(name="Ivy", age=7), loud=True) == "IVY, 7!"


def label(item: (id: int, user: (name: str))) -> str:  # nested and renamed
    (id=, user=(name=n)) = item
    return f"{id}:{n.title()}"


assert label((id=7, user=(name="kim"))) == "7:Kim"


def welcome_or_guest(person: Person = (name="guest", age=0)) -> str:  # a record default (no shorthand in it)
    (name=) = person
    return name


assert welcome_or_guest() == "guest" and welcome_or_guest((name="Bo", age=1)) == "Bo"


def age_of(p: (..., age: int)) -> int:  # open: any record with at least an int `age`
    return p.age


assert age_of((name="Ivy", age=7, extra=True)) == 7

# spreads: records are mappings by field name, so `**` works on them
first, last = (name="Ann", age=30), (surname="Lee", city="Oslo")


def card(name: str, age: int, surname: str, city: str) -> str:
    return f"{name} {surname}, {age}, {city}"


assert card(**first, **last) == "Ann Lee, 30, Oslo"  # spread into a call: checked by name
assert {**first, **last} == {"name": "Ann", "age": 30, "surname": "Lee", "city": "Oslo"}
older = (**first, age=31)  # build a record: a later field wins (like {**a, **b})
assert older == (name="Ann", age=31)
type Contact = (name: str, age: int, surname: str, city: str)
c: Contact = (**first, **last)  # checked against Contact: a missing or extra field is an error
assert c.city == "Oslo"


def mail(to: Contact) -> str:
    return f"{to.name} {to.surname}, {to.city}"


assert mail((**first, **last)) == "Ann Lee, Oslo"  # checked against mail's parameter: no type to write


def send(times: int, to: Contact, loud: bool = False) -> str:
    return f"{to.name} x{times}" + "!" * loud


assert send(2, (**first, **last)) == "Ann x2"  # any position: checked against `to`
assert send(2, to=(**first, **last), loud=True) == "Ann x2!"  # by keyword too


@overload
def lookup(key: int) -> int: ...
@overload
def lookup(key: Contact) -> str: ...
def lookup(key: int | Contact) -> int | str:
    return key if isinstance(key, int) else key.name


assert lookup((**first, **last)) == "Ann"  # overloads: the Contact one, so this is a str
assert lookup(7) == 7


# ============================================================================
# 4. ALL THREE TOGETHER
# ============================================================================


def area(*, w: float, h: float):
    a = w * h
    perimeter = 2 * (w + h)
    return (a=, perimeter=)


w, h = 3.0, 4.0
(a=, perimeter=p_) = area(w=, h=)  # call by name -> record -> destructure
assert (a, p_) == (12.0, 14.0)


# ============================================================================
# NOT PLANNED - each of these fails
# ============================================================================
# (name=) = {"name": "x"}             dicts: destructuring reads attributes, not keys (AttributeError)
# (keys=1)                            `keys` is reserved: records have keys() so that **record works
# (a, b=) = r                         positional items: fields are read by name, never by order
# def f(name=): ...                   would mean "default to the outer name"; shorthand is for call sites
# (_private=1)                        record fields can't start with "_" (NamedTuple rule)

print("all good")
