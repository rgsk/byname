# Every byname feature, read top to bottom. One rule for all of them: in `field=value` the left is the
# field or parameter name and the right is your local; a bare `field=` means `field=field`.

import copy
import json
import os
import pickle
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from textwrap import dedent
from typing import Final, Literal, overload

import pytest

from byname import deepdict, record, to_code, transform

# ============================================================================
# 1. CALLS: pass locals by name
# ============================================================================


def greet(*, name: str, age: int, loud: bool = False) -> str:
    s = f"{name} is {age}"
    return s.upper() if loud else s


def test_a_bare_keyword_passes_the_local_of_the_same_name():
    name, age = "rahul", 26
    assert greet(name=, age=) == "rahul is 26"


def test_it_is_only_the_keyword_written_twice():
    assert transform("greet(name=, age=)").body == "greet(name=name, age=age)"


def test_shorthand_mixes_with_explicit_values():
    name, age = "rahul", 26
    assert greet(name=, age=age + 1) == "rahul is 27"
    assert greet(name=, age=, loud=True) == "RAHUL IS 26"


def test_shorthand_goes_after_positional_arguments_and_with_kwargs():
    def tag(prefix: str, *, name: str, loud: bool = False) -> str:
        return f"{prefix}:{name}" + "!" * loud

    name = "rahul"
    opts = {"loud": True}
    assert tag("user", name=) == "user:rahul"
    assert tag("user", name=, **opts) == "user:rahul!"


def test_any_callable_takes_it_methods_and_builtins_too():
    class Greeter:
        def hello(self, *, name: str) -> str:
            return f"hello {name}"

    name, age = "rahul", 26
    assert Greeter().hello(name=) == "hello rahul"
    assert dict(name=, age=) == {"name": "rahul", "age": 26}  # noqa: C408 -- a builtin call is the point


def test_order_never_matters_because_every_argument_is_named():
    age, name = 26, "rahul"
    assert greet(age=, name=) == greet(name=, age=) == "rahul is 26"


def test_renaming_one_half_of_a_shorthand_splits_it():
    # `name=` is two symbols, the parameter and the local. The editor's rename changes only the one asked
    # for: renaming the parameter to `who` writes `who=name`, the local to `who` writes `name=who`. A plain
    # `who=` would pass whatever local is called `who`. A record field renames with the record it came from:
    # from `r.name`, the literal `r` was built from changes too (a shorthand keeps its local: `(who=name)`),
    # or the type `r` was declared with, `(who: str)`; another record that only has a `name` doesn't. It
    # starts from the type too: renaming `name` in `(name: str)` or `type User = (name: str)` renames
    # every read of a record typed by it, and every literal written where it's expected (`u: User = (...)`,
    # an argument, a `return`), both ways as in TypeScript (end to end in test_rename.py).
    def hello(*, who: str) -> str:
        return f"hello {who}"

    who, name = "someone else", "rahul"
    assert hello(who=name) == "hello rahul"
    assert hello(who=) == "hello someone else"


# ============================================================================
# 2. RECORDS: build a value from locals by name
# ============================================================================


def make(*, name: str, age: int):
    greeting = f"hi {name}"
    return (name=, age=, greeting=)


def test_a_record_is_built_from_locals_by_name():
    name, age = "rahul", 26
    r = (name=, age=)
    assert (r.name, r.age) == ("rahul", 26)


def test_a_function_returns_its_locals_by_name():
    r = make(name="rahul", age=26)
    assert (r.name, r.age, r.greeting) == ("rahul", 26, "hi rahul")


def test_it_is_a_call_to_a_class_named_after_its_fields():
    assert transform("(name=, age=)").body == "_rec_name__age(name=name, age=age)"


def test_fields_take_explicit_values_and_any_expression():
    name = "rahul"
    r = (name=name.upper(), score=10 * 9)
    assert (r.name, r.score) == ("RAHUL", 90)


def test_one_field_needs_no_trailing_comma():
    name = "rahul"
    assert (name=).name == "rahul"
    assert (name) == "rahul"  # no `=`: plain parentheses
    assert transform("(name=)").body == "_rec_name(name=name)"


def test_a_trailing_comma_changes_nothing_but_the_formatting():
    name = "rahul"
    short = (name=)
    split = (
        name=,
    )  # the trailing comma keeps the formatter from joining it
    assert short.name == split.name == "rahul"
    assert short._fields == split._fields == ("name",)


def test_a_long_record_spans_lines():
    name, age = "rahul", 26
    r = (
        name=,
        age=,
    )
    assert r.age == 26


def test_records_nest_and_go_anywhere_an_expression_can():
    name, age = "rahul", 26
    nested = (user=(name=, age=), ok=True)
    rows = [(i=, square=i * i) for i in range(3)]
    double = lambda x: (x=, twice=x * 2)
    assert nested.user.name == "rahul"
    assert repr(nested) == "(user=(name='rahul', age=26), ok=True)"
    assert [r.square for r in rows] == [0, 1, 4]
    assert repr(rows) == "[(i=0, square=0), (i=1, square=1), (i=2, square=4)]"
    assert double(5).twice == 10
    assert repr(double(5)) == str(double(5)) == "(x=5, twice=10)"
    assert repr((name=, age=)) == str((name=, age=)) == "(name='rahul', age=26)"  # as a call argument


# ============================================================================
# 3. WHAT A RECORD IS: fields read by name, never by position
# ============================================================================


def test_a_record_is_read_by_name_only(tmp_path):
    # field order never matters, so nothing reads a record by position: reorder a record's fields where
    # it's built and no reader changes meaning. Want positions? Return a tuple.
    verdicts = checker(
        """\
        def get_batch():
            return (x=1, y=2)
        r = get_batch()
        x, y = r
        r[0]
        for v in r: pass
        print(*r)
        sorted([r, r])
        (x=, y=) = r
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [4, 5, 6, 7, 8]  # line 9, by name, is the way
    assert verdicts[4].startswith('"(x: int, y: int)" is not iterable')
    assert verdicts[5].startswith('Argument of type "Literal[0]" cannot be assigned to parameter "k" of type "str"')
    assert "records are read by name: (x=, y=)" in verdicts[5]
    assert "records have no order: compare or sort by a field (key=lambda r: r.x)" in verdicts[8]


def test_at_runtime_a_record_is_a_named_tuple_stored_by_name():
    # a NamedTuple underneath (immutable, hashable, cheap), with its fields stored sorted by name and shown in
    # the order written
    r = (name="rahul", age=26)
    assert isinstance(r, tuple) and len(r) == 2
    assert r._fields == ("age", "name")
    assert tuple(r.keys()) == ("name", "age")  # what `**r` reads
    assert list(r._asdict()) == ["name", "age"]


def test_reading_by_position_raises_at_runtime_too():
    # the stored order is sorted by name, so anything positional would read an order nobody wrote
    r = (name="rahul", age=26)
    with pytest.raises(TypeError, match="read by name only"):
        _first, _second = r  # pyright: ignore[reportGeneralTypeIssues]
    with pytest.raises(TypeError, match="read by name only"):
        list(r)  # pyright: ignore[reportArgumentType]
    with pytest.raises(TypeError, match="read by name only"):
        _ = r[0]  # pyright: ignore[reportArgumentType]
    with pytest.raises(TypeError, match="read by name only"):
        _ = r + ()  # pyright: ignore[reportOperatorIssue]


def test_pandas_is_told_how_to_keep_the_written_order():
    # pandas reads a NamedTuple by position with `_fields`, the sorted storage order, as its columns: (step=, loss=)
    # would come out as loss, step. So it isn't let in; its error says what keeps the order: dict(rec) goes by keys()
    rows = [(step=1, loss=0.5)]
    with pytest.raises(TypeError, match=r"for a DataFrame, pd.DataFrame\(map\(dict, rows\)\) keeps the written order$"):
        exec("[tuple(r) for r in rows]", {"__name__": "pandas.core.internals.construction", "rows": rows})
    with pytest.raises(TypeError, match=r"_asdict\(\)$"):  # anyone else: no hint
        exec("[tuple(r) for r in rows]", {"__name__": "mylib", "rows": rows})
    assert list(map(dict, rows)) == [{"step": 1, "loss": 0.5}]


def test_a_traceback_shows_byname_s_own_code_under_its_own_name(tmp_path):
    # byname's runtime code (the prelude) is compiled into each file; its frames say so, with their own lines,
    # and the file's lines stay its own
    (tmp_path / "tb.pyn").write_text(
        dedent("""\
        import sys
        class Bad:
            def __repr__(self):
                raise ValueError("no repr")
        r = (a=1, b=2)
        def by_position():
            x, y = r
        if sys.argv[1] == "repr":
            repr((a=Bad()))
        by_position()
        """)
    )
    run = [sys.executable, "-m", "byname", "run", "tb.pyn"]
    out = subprocess.run([*run, "position"], cwd=tmp_path, capture_output=True, text=True, check=False).stderr
    assert 'File "tb.pyn", line 10, in <module>\n    by_position()' in out
    assert 'File "tb.pyn", line 7, in by_position\n    x, y = r' in out
    assert re.search(r'File "<byname prelude: tb.pyn>", line \d+, in _byname_positional\n +raise TypeError', out)
    assert not re.search(r'File "tb.pyn", line \d+, in _byname', out)
    # code nested in byname's own (a generator in its __repr__) too
    out = subprocess.run([*run, "repr"], cwd=tmp_path, capture_output=True, text=True, check=False).stderr
    assert re.search(r'File "<byname prelude: tb.pyn>", line \d+, in <genexpr>', out)
    assert 'File "tb.pyn", line 4, in __repr__\n    raise ValueError("no repr")' in out
    # this file runs through the pytest plugin, the same way
    assert type((a=1)).__iter__.__code__.co_filename == f"<byname prelude: {__file__}>"


def test_records_have_no_order():
    with pytest.raises(TypeError, match="'<' not supported"):
        sorted([(name="rahul", age=26), (name="tasha", age=22)])  # pyright: ignore[reportArgumentType]
    # order by a field
    assert min([(name="rahul", age=26), (name="tasha", age=22)], key=lambda u: u.age).name == "tasha"


def test_in_asks_for_a_field_name_like_a_dict(tmp_path):
    r = (name="rahul", age=26)
    assert "name" in r
    assert "rahul" not in r  # values aren't searched
    # allowed, but it doesn't narrow a union of records the way it narrows TypedDicts (see open_issues.md)
    assert checker('ok = "name" in (name="rahul")\n', tmp_path) == {}


def test_mappings_and_json_go_through_the_field_names():
    r = (name="rahul", age=26)
    assert {**r} == {"name": "rahul", "age": 26}
    # what `**r` reads, so they work at runtime; the checker rejects both (no `rec[...]`): use {**r}
    assert r["name"] == "rahul"  # pyright: ignore[reportIndexIssue]
    assert dict(r) == {**r}  # pyright: ignore[reportCallIssue, reportArgumentType]
    assert json.dumps({**r}) == '{"name": "rahul", "age": 26}'
    with pytest.raises(TypeError):
        json.dumps(r)  # json writes any tuple as a list, and a record won't be read as one


def test_pickle_and_copy_keep_a_record():
    r = (name="rahul", age=26)
    assert pickle.loads(pickle.dumps(r)) == copy.copy(r) == copy.deepcopy(r) == r
    assert repr(copy.deepcopy(r)) == "(name='rahul', age=26)"
    # pickled by field, rebuilt as the same class: a literal in either order, a spread, a rest, record()
    (name=, **rest) = (name="rahul", age=26, city="Pune")
    for x in [r, (age=26, name="rahul"), (**r, city="Pune"), rest, record(Person, {"name": "gil", "age": 3})]:
        y = pickle.loads(pickle.dumps(x))
        assert y == x and type(y) is type(x) and repr(y) == repr(x)


def test_a_record_unpickles_in_another_process(tmp_path):
    # what DataLoader workers, multiprocessing and torch.load do: the module is imported afresh there
    (tmp_path / "a.pyn").write_text("def make(): return (name='rahul', age=26)\nr = make()\nu = (**r, city='Pune')\n")
    (tmp_path / "b.pyn").write_text("r = (name='rahul', age=26)\n")
    (tmp_path / "dump.pyn").write_text(
        dedent("""\
        import pickle, sys
        import a, b
        out = [a.r, a.u, b.r]
        del type(a.r).__reduce__  # pickled by class name, as before records pickled by field
        out.append(a.r)
        sys.stdout.buffer.write(pickle.dumps(out))
        """)
    )
    (tmp_path / "load.pyn").write_text(
        dedent("""\
        import pickle, sys
        import a, b
        ar, au, br, old = pickle.loads(sys.stdin.buffer.read())
        assert type(ar) is type(a.r) and type(au) is type(a.u) and type(br) is type(b.r)
        assert ar == br == old == a.r and au == a.u and type(old) is type(a.r)
        print(au)
        """)
    )
    run = [sys.executable, "-m", "byname", "run"]
    dumped = subprocess.run([*run, "dump.pyn"], cwd=tmp_path, capture_output=True, check=True).stdout
    loaded = subprocess.run([*run, "load.pyn"], cwd=tmp_path, input=dumped, capture_output=True, check=False)
    assert loaded.stdout.decode() == "(name='rahul', age=26, city='Pune')\n", loaded.stderr.decode()


def test_each_field_list_gets_one_class():
    r = (name="rahul", age=26)
    assert type(r).__name__ == "record(name, age)"  # what error messages say, fields as written
    assert type(r) is type((name="tasha", age=23))
    assert type(r) is type((name=23, age="tasha"))  # value types live only in the checker: (name: int, age: str)
    assert type(r) is not type((age=23, name="tasha"))  # another order, another class


def test_error_messages_name_the_record_by_its_fields():
    r = (name="rahul", age=26)
    with pytest.raises(AttributeError, match=r"^'record\(name, age\)' object has no attribute 'nme'$"):
        _ = r.nme  # pyright: ignore[reportAttributeAccessIssue]
    with pytest.raises(TypeError, match=r"^record\(name, age\) is read by name only"):
        _ = r[0]  # pyright: ignore[reportArgumentType]


def test_a_record_is_immutable():
    r = (name="rahul", age=26)
    with pytest.raises(AttributeError):
        r.age = 27  # pyright: ignore[reportAttributeAccessIssue]


def test_replace_copies_with_some_fields_changed():
    r = (name="rahul", age=26)
    older = r._replace(age=27)
    assert (older.name, older.age) == ("rahul", 27)
    assert r.age == 26
    with pytest.raises(ValueError, match="agee"):
        r._replace(agee=27)  # pyright: ignore[reportCallIssue]


def test_asdict_gives_the_fields_in_written_order():
    assert (name="rahul", age=26)._asdict() == {"name": "rahul", "age": 26}


def test_equality_compares_fields_by_name_in_any_order():
    assert (name="rahul", age=26) == (age=26, name="rahul")
    assert (name="rahul", age=26) != (name="rahul", agee=26)  # another field set
    assert (name="rahul", age=26) != ("rahul", 26)  # never equal to a plain tuple
    assert ("rahul", 26) != (name="rahul", age=26)


def test_a_record_is_hashable_so_it_can_be_a_dict_key():
    seen = {(name="rahul", age=26): "found"}
    assert seen[(name="rahul", age=26)] == "found"
    assert seen[(age=26, name="rahul")] == "found"  # equal records hash alike


def lo_hi(xs: list[int]):
    lo, hi = min(xs), max(xs)
    return lo, hi


def test_a_returned_tuple_shows_the_names_it_was_returned_from(tmp_path):
    # Want positions? Return a tuple: hover labels each position with the name returned there, so the order
    # is documented with nothing written. A plain tuple at runtime, read by position as usual.
    lo, hi = lo_hi([3, 1, 2])
    assert (lo, hi) == (1, 3) and type(lo_hi([1])) is tuple
    verdicts = checker(
        """\
        def get_batch(n: int):
            x, y = [n], "s"
            return x, y.upper()
        def lo_hi(n: int):
            lo, hi = n, n + 1
            return lo, hi
        def annotated(n: int) -> tuple[int, int]:
            lo = n
            return lo, lo
        reveal_type(get_batch)
        reveal_type(lo_hi)
        reveal_type(annotated)
        lo, hi = lo_hi(1)
        reveal_type(hi)
        lo_hi(1).hi
        def moved(x: list[int], y: list[int]):
            return (x := x * 2, y := y * 2)  # a walrus labels its position too
        reveal_type(moved)
        """,
        tmp_path,
    )
    assert verdicts[10] == 'Type of "get_batch" is "(n: int) -> tuple[x: list[int], str]"'  # `y.upper()` isn't a name
    assert verdicts[11] == 'Type of "lo_hi" is "(n: int) -> tuple[lo: int, hi: int]"'
    assert verdicts[12] == 'Type of "annotated" is "(n: int) -> tuple[int, int]"'  # what's written wins
    assert verdicts[14] == 'Type of "hi" is "int"'
    assert verdicts[15].startswith('Cannot access attribute "hi"')  # labels are for reading, not attributes
    assert verdicts[18] == 'Type of "moved" is "(x: list[int], y: list[int]) -> tuple[x: list[int], y: list[int]]"'


# ============================================================================
# 4. DESTRUCTURING: bind fields to locals by name
# ============================================================================


def test_destructuring_binds_fields_to_locals_by_name():
    (name=, age=) = (name="rahul", age=26)
    assert (name, age) == ("rahul", 26)


def test_it_is_one_attribute_read_per_field():
    assert transform("(name=, age=years) = r").body == "_ds = r; name = _ds.name; years = _ds.age"


def test_fields_come_out_in_any_order_and_any_subset():
    (age=, name=) = (name="rahul", age=26, greeting="hi rahul")
    (greeting=) = (name="rahul", age=26, greeting="hi rahul")
    assert (name, age, greeting) == ("rahul", 26, "hi rahul")


def test_a_field_can_be_renamed_into_another_local():
    (name=who, age=years) = (name="rahul", age=26)
    assert (who, years) == ("rahul", 26)


def test_one_field_can_go_into_two_locals():
    (name=, name=alias) = (name="rahul", age=26)
    assert name == alias == "rahul"


def test_a_field_can_be_taken_whole_and_destructured_too():
    # like TypeScript's `const { details: personalDetails, details: { sex } } = user`. Ctrl+click on `sex`
    # (here or in `user.details.sex`) goes to `sex=` in the literal, as TypeScript does for an object bound to
    # no type; with `user: User = ...` it goes to the type's field (end to end in test_rename.py)
    user = (name="rahul", age=27, details=(sex="male"))
    (details=personal_details, details=(sex=)) = user
    assert (personal_details, sex) == ((sex="male"), "male")


def test_targets_can_be_attributes_and_subscripts():
    class Box:
        label = ""

    box, ages = Box(), {}
    (name=box.label, age=ages["rahul"]) = (name="rahul", age=26)
    assert (box.label, ages) == ("rahul", {"rahul": 26})


def test_renaming_both_ways_swaps_two_locals():
    a, b = 1, 2
    (a=b, b=a) = (a=, b=)
    assert (a, b) == (2, 1)


def test_a_long_pattern_spans_lines():
    (
        name=,
        age=,
    ) = (name="rahul", age=26)
    assert (name, age) == ("rahul", 26)


def test_any_object_with_attributes_destructures():
    @dataclass
    class User:
        name: str
        email: str

    (real=re, imag=im) = 3 + 4j  # builtins
    (email=) = User("rahul", "rahul@x.com")  # dataclasses
    (sep=, curdir=) = os  # modules
    assert (re, im, email, sep, curdir) == (3.0, 4.0, "rahul@x.com", "/", ".")


def test_a_method_can_unpack_self_and_fill_many_attributes():
    class Point:
        def __init__(self, x: int, y: int):
            (x=self.x, y=self.y) = (x=, y=)

        def norm2(self) -> int:
            (x=, y=) = self
            return x * x + y * y

    assert Point(3, 4).norm2() == 25


def test_final_on_a_pattern_makes_every_local_it_binds_final():
    (name=, age=years): Final = (name="rahul", age=26)
    assert (name, years) == ("rahul", 26)
    # the annotation goes on each local, never on `_ds`, which every pattern binds again
    assert transform("(name=, age=years): Final = r").body == "_ds = r; name: Final = _ds.name; years: Final = _ds.age"


def test_the_checker_rejects_changing_a_final_local(tmp_path):
    verdicts = checker(
        """\
        from typing import Final
        type Cfg = (lr: float, schedule: (max_steps: int))
        def train(cfg: Cfg):
            (lr=, schedule=(max_steps=)): Final = cfg
            max_steps += 1
            model = "trained"
            (model=): Final = (model="best")
            return lr, max_steps, model
        """,
        tmp_path,
    )
    nested_changed, overwritten = 5, 7
    assert verdicts[nested_changed].startswith('"max_steps" is declared as Final and cannot be reassigned')
    # Final means one binding in the whole scope, so a Final pattern can't take over a name either
    assert verdicts[overwritten].startswith('"model" is declared as Final and cannot be reassigned')
    assert len(verdicts) == 2


def test_a_final_pattern_is_not_a_loop_and_takes_no_other_annotation():
    with pytest.raises(SyntaxError, match="loop pattern can't be Final"):
        transform("for (name=): Final in people: pass")
    with pytest.raises(SyntaxError, match="annotation can only be Final"):
        transform("(name=): str = r")


# ============================================================================
# 5. DESTRUCTURING IN LOOPS AND NESTED PATTERNS
# ============================================================================


def test_a_for_loop_destructures_each_record():
    people = [(name="rahul", age=26), (name="tasha", age=23)]
    seen = []
    for (name=, age=years) in people:
        seen.append(f"{name}:{years}")
    assert seen == ["rahul:26", "tasha:23"]


def test_the_loop_reads_fields_through_a_generator():
    assert (
        transform("for (name=, age=years) in people: pass").body
        == "for (name, years) in ((_ds.name, _ds.age) for _ds in people): pass"
    )


def test_comprehensions_destructure_the_same_way():
    people = [(name="rahul", age=26), (name="tasha", age=23)]
    assert [f"{name}:{age}" for (name=, age=) in people] == ["rahul:26", "tasha:23"]
    assert {name: age for (name=, age=) in people} == {"rahul": 26, "tasha": 23}


def test_a_pattern_is_written_like_the_record_it_takes_apart():
    local_name = "rahul"
    r = (user=(name=local_name))  # build
    del local_name
    (user=(name=local_name)) = r  # take apart, the same text on the other side
    assert local_name == "rahul"


def test_a_nested_pattern_reads_through_the_outer_field():
    (user=(name=, age=years), ok=) = (user=(name="rahul", age=26), ok=True)
    assert (name, years, ok) == ("rahul", 26, True)


def test_nesting_is_a_chain_of_attribute_reads():
    assert transform("(user=(name=), ok=) = r").body == "_ds = r; name = _ds.user.name; ok = _ds.ok"


def test_loops_take_nested_patterns_too():
    rows = [(user=(name="rahul"), ok=True), (user=(name="tasha"), ok=False)]
    assert [name for (user=(name=), ok=) in rows if ok] == ["rahul"]


# ============================================================================
# 6. RECORD TYPES: written the way hover shows them
# ============================================================================


def checker(src: str, tmp_path: Path) -> dict[int, str]:
    # basedpyright's verdicts on `src` by line (errors and reveal_type notes); one line's messages split by a blank line
    (tmp_path / "snippet.pyn").write_text(dedent(src))
    run = [sys.executable, "-m", "byname", "tool", "basedpyright", "snippet.pyn"]
    out = subprocess.run(run, cwd=tmp_path, capture_output=True, text=True, check=False).stdout
    verdicts: dict[int, str] = {}
    line = 0
    for row in out.splitlines():
        if m := re.match(r"\s*snippet\.pyn:(\d+):\d+ - \w+: (.*)", row):
            line = int(m[1])
            verdicts[line] = verdicts[line] + "\n\n" + m[2] if line in verdicts else m[2]
        elif line and row.startswith("  "):  # a message's next lines (indented with non-breaking spaces)
            verdicts[line] += "\n" + row.strip()
    return verdicts


type Person = (name: str, age: int)


def test_a_record_type_is_written_the_way_hover_shows_it():
    gil: Person = (age=30, name="gil")
    assert (gil.name, gil.age) == ("gil", 30)
    assert transform("type Person = (name: str, age: int)").body == "type Person = _typ_name__age[str, int]"


def test_a_record_type_types_a_record_but_does_not_build_one(tmp_path):
    # `type` makes a TypeAliasType, which Python doesn't call, so a type goes on the name: an annotation.
    # An inline type can't be called either (see section 9), so a type is used the same way, named or not
    a: Person = (name="gil", age=30)
    b: (name: str, age: int) = (name="gil", age=30)
    assert a == b
    with pytest.raises(TypeError, match="not callable"):
        Person(name="gil", age=30)  # pyright: ignore[reportCallIssue]
    verdicts = checker(
        """\
        type Person = (name: str, age: int)
        a: Person = (name="gil", age=30)
        c = Person(name="gil", age=30)
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [3]
    assert verdicts[3].startswith('Object of type "TypeAliasType" is not callable')


def test_a_record_type_takes_any_field_order_but_exactly_its_fields(tmp_path):
    verdicts = checker(
        """\
        type Person = (name: str, age: int)
        a: Person = (age=30, name="gil")
        b: Person = (name="gil", age=30, email="g@x")
        c: Person = (name="gil",)
        d: Person = (name="gil", age="thirty")
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [3, 4, 5]  # line 2, another order, is fine
    assert "extra field: email" in verdicts[3]
    assert "missing field: age" in verdicts[4]
    assert '"age" is an incompatible type' in verdicts[5]


def test_a_field_takes_a_narrower_type_as_a_tuple_does(tmp_path):
    # records are immutable, so (dropout: int) fits (dropout: float) as tuple[int] fits tuple[float],
    # even once the record is stored with no type; a list of them stays invariant, as list itself is
    verdicts = checker(
        """\
        def train(cfg: (dropout: float, lr: float)) -> None: ...
        def peek(p: (..., dropout: float)) -> None: ...
        cfg = (dropout=0, lr=1e-3)
        train(cfg)
        peek(cfg)
        train(cfg._replace(dropout=1))
        nested: (inner: (dropout: float, lr: float)) = (inner=cfg)
        cfg._replace(dropout="x")
        s: (dropout: str, lr: float) = cfg
        xs: list[(dropout: float, lr: float)] = [cfg]
        ys = [cfg]
        zs: list[(dropout: float, lr: float)] = ys
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [8, 9, 12]  # lines 4-7 and 10 are fine
    assert 'parameter "dropout" of type "int"' in verdicts[8]
    assert '"dropout" is an incompatible type' in verdicts[9]
    assert "list" in verdicts[12]


def test_records_of_one_shape_are_one_type_inside_a_list(tmp_path):
    # list and dict are invariant: their items must be the same type, not one that fits. Records of one
    # field set are, wherever and in whatever order they were written (transform.canonical): a list of
    # literals is a list[Item], Item's list is a list of the same type written inline in another order, and a
    # list of both orders is one type, not a union. The wrong shape is still an error. Shown in the order the
    # file first writes the fields in, Item's (lsp.pretty)
    verdicts = checker(
        """\
        type Item = (sku: str, qty: int)
        type Order = (id: int, customer: (name: str), items: list[Item])
        def total(items: list[Item]) -> int: ...
        def again(items: list[(qty: int, sku: str)]) -> int: ...
        def by_sku(d: dict[str, (sku: str, qty: int)]) -> None: ...
        def bill(order: Order) -> None: ...
        xs = [(qty=3, sku="pen"), (sku="cap", qty=1)]
        total(xs)
        typed: list[Item] = xs
        again(typed)
        by_sku({"pen": xs[0]})
        one = (id=5, customer=(name="dev"), items=[(qty=1, sku="cap")])
        bill(one)
        total([(sku="pen")])
        reveal_type(xs)
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [14, 15]  # lines 8-13 are fine
    assert "missing field: qty" in verdicts[14]
    assert verdicts[15] == 'Type of "xs" is "list[(sku: str, qty: int)]"'


def test_records_of_one_shape_are_one_type_inside_a_list_across_files(tmp_path):
    # a shape's class is one for the project, not per file (transform.SHAPES): a list built here fits the
    # list[Item] of another module's function; the wrong field type is still an error
    (tmp_path / "shop.pyn").write_text("type Item = (sku: str, qty: int)\n\n\ndef total(items: list[Item]) -> int:\n    return len(items)\n")
    verdicts = checker(
        """\
        from shop import total
        xs = [(sku="pen", qty=3)]
        total(xs)
        ys = [(sku=1, qty=3)]
        total(ys)
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [5]  # line 3 is fine
    assert "list" in verdicts[5]


def test_an_open_type_takes_at_least_its_fields(tmp_path):
    verdicts = checker(
        """\
        def age_of(p: (..., age: int)) -> int:
            return p.age
        age_of((name="ivy", age=7, tall=True))
        age_of((name="ivy",))
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [4]
    assert '"age" is not present' in verdicts[4]


def test_brackets_read_a_record_unchecked(tmp_path):
    # `rec.name` is checked; `rec["name"]` is the way around the checker: any str key, typed Any, also on an
    # open type or a union, and a KeyError at runtime if the field isn't there. `in` asks for a field name
    verdicts = checker(
        """\
        def greet(p: (..., name: str)) -> str:
            if "title" in p:
                return p["title"] + p.name
            return p.name
        anyone: (...) = (age=1)
        users = [(name="rahul"), (age=27)]
        print(greet((name="ivy", title="dr")), anyone["age"], users[0]["name"], users[1]["nmae"])
        print(anyone.keys(), dict(anyone), {**anyone})  # an open type is a record: keys() and `**` too
        """,
        tmp_path,
    )
    assert verdicts == {}
    r = (name="ivy", title="dr")
    assert r["title"] == "dr" and "title" in r
    with pytest.raises(KeyError):
        r["nmae"]


def test_a_dot_read_of_an_undeclared_field_says_how_to_declare_it(tmp_path):
    # the gradual path: `p: (...)` read with brackets, unchecked, then its fields declared, `(..., msg: str)`,
    # and read with dots, checked. A dot read of a field the open type doesn't declare says both ways on (the
    # editor's quick fix, Read it unchecked, writes the bracket read; once the field is declared, the editor
    # hints the other way, Read it checked: brackets stay unchecked even for a declared field)
    verdicts = checker(
        """\
        def log(p: (...), q: (..., step: int)):
            print(p.msg, q.msg)
        """,
        tmp_path,
    )
    assert verdicts == {
        2: '"msg" isn\'t declared on (...): declare it, (..., msg: <type>), or read it unchecked with ["msg"]'
        " (reportAttributeAccessIssue)\n\n"
        '"msg" isn\'t declared on (..., step: int): declare it, (..., step: int, msg: <type>), or read it unchecked '
        'with ["msg"] (reportAttributeAccessIssue)'
    }


def test_an_open_type_takes_records_only(tmp_path):
    # unlike `.name`, `p["name"]` needs a mapping underneath: a dataclass or any other object won't do
    verdicts = checker(
        """\
        from dataclasses import dataclass
        @dataclass
        class D:
            age: int
        def age_of(p: (..., age: int)) -> int:
            return p.age
        age_of(D(age=1))
        age_of(3)
        def anything(p: (...)) -> None: ...
        anything(3)
        anything((a=1))
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [7, 8, 10]


def test_a_record_type_is_read_by_name_too(tmp_path):
    verdicts = checker(
        """\
        def get_batch() -> (x: int, y: int):
            return (y=2, x=1)
        x, y = get_batch()
        (x=, y=) = get_batch()
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [3]  # positionally, x would be 2 here: the type allows either order
    assert verdicts[3].startswith('"(x: int, y: int)" is not iterable')


def depth(n: int):  # hover: def depth(n: int) -> Unknown
    if n == 0:
        return (d=0)
    (d=) = depth(n - 1)
    return (d=d + 1)


def depth_typed(n: int) -> (d: int):  # hover: def depth_typed(n: int) -> (d: int)
    if n == 0:
        return (d=0)
    (d=) = depth_typed(n - 1)
    return (d=d + 1)


def test_a_recursive_function_writes_its_record_type():
    # hover the `.d`s: depth(3).d is `int | Unknown`, depth_typed(3).d is `int`
    assert depth(3).d == depth_typed(3).d == 3


def test_the_checker_infers_a_written_record_type(tmp_path):
    verdicts = checker(
        """\
        def depth(n: int):
            if n == 0:
                return (d=0)
            (d=) = depth(n - 1)
            return (d=d + 1)
        def depth_typed(n: int) -> (d: int):
            if n == 0:
                return (d=0)
            (d=) = depth_typed(n - 1)
            return (d=d + 1)
        reveal_type(depth)
        reveal_type(depth_typed)
        reveal_type(depth_typed(3).d)
        """,
        tmp_path,
    )
    assert (
        verdicts
        == {
            11: 'Type of "depth" is "(n: int) -> ((d: int) | (d: int | Unknown))"',  # inference can't see through the recursive call
            12: 'Type of "depth_typed" is "(n: int) -> (d: int)"',
            13: 'Type of "depth_typed(3).d" is "int"',
        }
    )


# 7. PARAMETERS: give the parameter a name, destructure it in the body
#    (no pattern in a signature: there `name=` is a default and nothing else; Python dropped tuple
#    parameters too, PEP 3113)
# ============================================================================


def intro(person: Person, loud: bool = False) -> str:
    (name=, age=) = person
    if loud:
        return f"{name.upper()}, {age}!"
    return f"{name}, {age}"


def test_a_parameter_is_destructured_first_in_the_body():
    assert intro((name="gil", age=30)) == "gil, 30"
    assert intro(person=(age=7, name="ivy"), loud=True) == "IVY, 7!"  # it has a name, so it passes by keyword


@pytest.mark.parametrize(
    "src",
    [
        "def f((name=, age=): Person): ...",
        "def f(x, (name=)): ...",
        "def f((id=, user=(name=n))): ...",
        "def f((name=) = (name='u')): ...",
        "def f[T]((name=): T): ...",
    ],
)
def test_a_pattern_in_a_signature_is_an_error(src):
    with pytest.raises(
        SyntaxError, match=r"can't destructure a parameter: give it a name and destructure it in the body"
    ):
        transform(src)


def test_shorthand_in_a_default_is_still_an_error():
    with pytest.raises(
        SyntaxError, match=r"name= in a parameter's default would take the outer 'name': write name=name"
    ):
        transform("def welcome(user=(name=)): ...")


# ============================================================================
# 8. SPREADS: `**record`, by field name, like `**dict`
# ============================================================================


def card(name: str, age: int, surname: str, city: str) -> str:
    return f"{name} {surname}, {age}, {city}"


def test_a_record_spreads_into_a_call_by_field_name():
    person, place = (name="ann", age=30), (surname="lee", city="oslo")
    assert card(**person, **place) == "ann lee, 30, oslo"


def test_a_record_spreads_into_a_dict():
    person, place = (name="ann", age=30), (surname="lee", city="oslo")
    assert {**person, **place} == {"name": "ann", "age": 30, "surname": "lee", "city": "oslo"}


def test_a_record_built_from_spreads_takes_the_later_field_in_the_first_position():
    defaults = (lr=1e-2, eval_iters=100)
    cfg = (**defaults, batch_size=32, lr=3e-3)
    assert repr(cfg) == "(lr=0.003, eval_iters=100, batch_size=32)"


def test_a_spread_of_a_call_is_typed_when_the_function_shows_its_fields(tmp_path):
    # a function shows the fields of what it returns by its annotation, or by its `return`s when they all
    # show the same ones (a function returning another's result is followed, into other modules too)
    (tmp_path / "people.pyn").write_text("def load():\n    return (name='ann', city='oslo')\n")
    verdicts = checker(
        """\
        from people import load
        def make(n: int):
            return (name="ann", age=n)
        def relay():
            return load()
        x = make(1)
        s1 = (**x, zip=1)
        s2 = (**make(1), zip=1)
        s3 = (**relay(), name=2)
        reveal_type(s1)
        reveal_type(s2)
        reveal_type(s3)
        s1.zpi
        s4 = (**make("1"), zip=nope)
        """,
        tmp_path,
    )
    assert verdicts[10] == 'Type of "s1" is "(name: str, age: int, zip: int)"'
    assert verdicts[11] == 'Type of "s2" is "(name: str, age: int, zip: int)"'
    assert verdicts[12] == 'Type of "s3" is "(name: int, city: str)"'  # a later field wins, in the first place
    assert verdicts[13].startswith('Cannot access attribute "zpi"')
    errors = verdicts[14].split("\n\n")  # the call is written out once: each mistake reported once
    assert len(errors) == 2
    assert 'Argument of type "Literal[\'1\']"' in errors[0] and '"nope" is not defined' in errors[1]
    assert sorted(verdicts) == [10, 11, 12, 13, 14]


def test_a_spread_of_a_call_the_checker_types_as_no_one_record_is_open(tmp_path):
    verdicts = checker(
        """\
        import functools
        def either(c: bool):
            if c:
                return (name="a")
            return (name="a", age=1)
        @functools.cache
        def cached():
            return (name="a")
        e = (**either(True), zip=1)
        c = (**cached(), zip=1)
        reveal_type(e)
        reveal_type(c)
        """,
        tmp_path,
    )
    # returns of different fields: the checker's answer is a union, so an open record of the fields written
    # after the spread (see test_a_spread_with_no_type_expected_is_open); annotate the function instead. A
    # decorator byname can't follow, the checker can: functools.cache keeps what `cached` returns
    assert verdicts == {11: 'Type of "e" is "(..., zip: int)"', 12: 'Type of "c" is "(name: str, zip: int)"'}


def test_a_spread_with_no_type_expected_is_open(tmp_path):
    # `**rest` of an open record carries the fields nobody declared, like **kwargs. Rebuilt with nothing to
    # say what's expected (a return with no `->`, a name with no annotation), the record is open: the fields
    # written after the last spread are known, the spread's aren't. Where a type is expected it's checked
    # against that type, as before
    verdicts = checker(
        """\
        def greet(u: (..., name: str, age: int)):
            (name=, age=, **rest) = u
            return (**rest, name=name.upper())
        out = greet((name="rahul", age=26, sex="male"))
        moved = (**out, city="pune")
        reveal_type(out)
        reveal_type(out.name)
        reveal_type(moved)
        """,
        tmp_path,
    )
    assert verdicts == {
        6: 'Type of "out" is "(..., name: str)"',
        7: 'Type of "out.name" is "str"',
        8: 'Type of "moved" is "(..., city: str)"',
    }

    def greet(u: (..., name: str, age: int)):
        (name=, age=, **rest) = u
        return (**rest, name=name.upper())

    assert greet((name="rahul", age=26, sex="male")) == (sex="male", name="RAHUL")


def test_a_spread_is_exact_wherever_the_checker_knows_its_source(tmp_path):
    # a spread source the file doesn't show the fields of (a loop's item, an index, a method's or call's result,
    # an attribute, any expression) is asked of the checker: the file goes to it once with each such source in
    # reveal_type, and its answers type the spreads. What the checker doesn't know either (no type, Any, a
    # union) stays open
    verdicts = checker(
        """\
        type User = (name: str, age: int)
        class Db:
            users: list[User] = []
        def load() -> list[User]: ...
        def f(users: list[User], db: Db, rows, maybe: User | None):
            for u in users:
                reveal_type((**u, zip=1))
            first = users.pop()
            reveal_type((**first, zip=1))
            for u in load():
                reveal_type((**u, zip=1))
            for u in db.users:
                moved = (**u, zip=1)
                again = (**moved, city="x")  # a spread of a probed spread
                reveal_type(again)
            for r in rows:
                open_ = (**r, zip=1)
                reveal_type(open_)
            m = (**maybe, zip=1)  # a union, no one record: open; and it may be None, which can't be spread
            reveal_type(m)
            label = "😀"; top = (**users[0], zip=1)  # an expression, after a wide character
            reveal_type(top)
            reveal_type((**db.users[-1], zip=1))
            ignored = (**users[1], zip=1)  # pyright: ignore
            reveal_type(ignored)  # the comment hid the probe's answer; the probe blanks it
        """,
        tmp_path,
    )
    exact = 'is "(name: str, age: int, zip: int)"'
    assert all(verdicts[n].endswith(exact) for n in [7, 9, 11])
    assert verdicts[15] == 'Type of "again" is "(name: str, age: int, zip: int, city: str)"'
    assert verdicts[18] == 'Type of "open_" is "(..., zip: int)"'
    assert verdicts[19] == (
        "can't spread User | None: it may be None. Narrow it first; a record or a mapping is spread by name"
        " (reportArgumentType)"
    )
    assert verdicts[20] == 'Type of "m" is "(..., zip: int)"'
    assert verdicts[22].endswith(exact) and verdicts[23].endswith(exact) and verdicts[25].endswith(exact)
    assert sorted(verdicts) == [7, 9, 11, 15, 18, 19, 20, 22, 23, 25]

    users = [(name="a", age=1)]
    assert (**users[0], zip=1) == (name="a", age=1, zip=1)
    assert [(**u, zip=1) for u in users] == [(name="a", age=1, zip=1)]


def test_only_a_record_or_a_mapping_can_be_spread(tmp_path):
    # `**` takes what has keys(), at runtime and for the checker: a record (open ones too) or a mapping. None
    # can't be spread, nor an int: a dict display says "Expected mapping"; a record built from spreads says it
    # in its own words, wherever it stands (no type expected too: transform's _byname_loose)
    verdicts = checker(
        """\
        type User = (name: str, age: int)
        def f(maybe: User | None, d: dict[str, int] | None, n: int, o: (..., name: str), ok: dict[str, int]):
            a = (**maybe, zip=1)
            b = (**d, zip=1)
            c = (**n, zip=1)
            fine = (**o, zip=1), (**ok, zip=1)
            if maybe is not None:
                narrowed = (**maybe, zip=1)
                reveal_type(narrowed)
        """,
        tmp_path,
    )
    may_be_none = "it may be None. Narrow it first; a record or a mapping is spread by name (reportArgumentType)"
    assert verdicts[3] == f"can't spread User | None: {may_be_none}"
    assert verdicts[4] == f"can't spread dict[str, int] | None: {may_be_none}"
    assert verdicts[5] == "can't spread int: a record or a mapping is spread by name (reportArgumentType)"
    assert verdicts[9] == 'Type of "narrowed" is "(name: str, age: int, zip: int)"'
    assert sorted(verdicts) == [3, 4, 5, 9]
    with pytest.raises(TypeError, match="not a mapping"):  # what runs says so too
        (**None, zip=1)  # pyright: ignore


def test_a_field_a_spread_brought_says_where_it_went(tmp_path):
    # a spread of a record whose fields nobody can see (an item of a list with no type, a dict) builds an open
    # record of the fields written after it: a field read off it, or a type it's passed as, says that it came
    # from the spread and how to check it, not to declare it on a type nobody wrote
    verdicts = checker(
        """\
        type User = (name: str, age: int)
        def take(p: User) -> None: ...
        def f(users: list[User], rows, d: dict[str, int], o: (..., name: str)):
            for u in rows:
                moved = (**u, zip=1)
                moved.name
                take(moved)
            m = (**d, zip=1)
            m.name
            v: User
            for v in users:
                exact = (**v, zip=1)
                exact.name
            (name=, **rest) = o
            back = (**rest, zip=1)
            back.agee
        """,
        tmp_path,
    )
    seen = "whose fields byname can't see"
    assert verdicts[6] == (
        f'"name" isn\'t on (..., zip: int): it\'s built from a spread of u, {seen}. To check it, give u a record'
        ' type; or read it unchecked with ["name"] (reportAttributeAccessIssue)'
    )
    assert f"missing fields: age, name\nit's built from a spread of u, {seen}. To check it, give u a record type" in verdicts[7]
    assert verdicts[9].startswith(f'"name" isn\'t on (..., zip: int): it\'s built from a spread of d, {seen}')
    # a known record spreads exactly (line 13: no error); an open one carries fields nobody declared, by design
    assert verdicts[16].startswith('"agee" isn\'t declared on (..., zip: int): declare it')
    assert sorted(verdicts) == [6, 7, 9, 16]


def test_a_spread_of_known_records_is_typed_without_an_annotation(tmp_path):
    verdicts = checker(
        """\
        defaults = (lr=1e-2, eval_iters=100)
        cfg = (**defaults, batch_size=32)
        reveal_type(cfg)
        cfg.btach_size
        """,
        tmp_path,
    )
    assert verdicts[3] == 'Type of "cfg" is "(lr: float, eval_iters: int, batch_size: int)"'
    assert verdicts[4].startswith('Cannot access attribute "btach_size"')


def test_a_record_s_asdict_is_a_typed_mutable_copy_that_spreads_back(tmp_path):
    # `_asdict()` gives a dict with the record's fields (keys can't be added or removed), so `(**d)` is a
    # record of those fields again: typed with no annotation, read as d["name"] for the checker
    verdicts = checker(
        """\
        rec = (name="rahul", age=26)
        d = rec._asdict()
        d["age"] += 1
        back = (**d, city="Pune")
        reveal_type(back)
        """,
        tmp_path,
    )
    assert verdicts[5] == 'Type of "back" is "(name: str, age: int, city: str)"'
    rec = (name="rahul", age=26)
    d = rec._asdict()
    d["age"] += 1
    assert (**d, city="Pune") == (name="rahul", age=27, city="Pune")


def test_spreading_back_into_the_same_name_keeps_its_type(tmp_path):
    # a spread reads the nearest binding of each name before it (bindings in straight-line code), so spreading
    # back into the name it came from keeps the type, whether it spreads the record itself or its `_asdict()`
    verdicts = checker(
        """\
        r = (name="rahul", age=26)
        r = (**r)
        reveal_type(r)
        u = (name="rahul", age=26)
        u_mutable = u._asdict()
        u = (**u_mutable)
        reveal_type(u)
        v = (name="rahul", age=26)
        v_mutable = v._asdict()
        v2 = (**v_mutable)
        reveal_type(v2)
        w: (name: str, age: int) = (name="rahul", age=26)
        w_mutable = w._asdict()
        w = (**w_mutable)
        reveal_type(w)
        """,
        tmp_path,
    )
    assert verdicts[3] == 'Type of "r" is "(name: str, age: int)"'  # the record itself
    assert verdicts[7] == 'Type of "u" is "(name: str, age: int)"'  # its dict
    assert verdicts[11] == 'Type of "v2" is "(name: str, age: int)"'  # a new name
    assert verdicts[15] == 'Type of "w" is "(name: str, age: int)"'  # an annotation


def test_a_spread_is_typed_when_every_binding_that_may_reach_it_has_the_same_fields(tmp_path):
    # a name bound in a branch, a loop or `try`, rebound and read from a function, or rebound through `global`:
    # any of its bindings may be the one that ran, so the spread is typed only when they all have the same
    # fields (the field types are the checker's union). When they differ it's open, `(...)`: annotate it
    verdicts = checker(
        """\
        import random
        c = random.random() > 0.5
        q = (name="a", age=1)
        if c:
            q = (name="b", age="x")
        e1 = (**q)
        try:
            t = (name="a", age=1)
        except Exception:
            t = (name="b", age=2, adult=False)
        e2 = (**t)
        cfg = (lr=1e-3, steps=100)
        cfg = (lr=3e-4, steps=200)
        def train():
            return (**cfg, seed=0)
        g = (name="gil", age=30)
        def bump():
            global g
            g = (name="gil", age=31)
        e3 = (**g)
        w = (a=1)
        e4 = w
        while c:
            e4 = (**w)
            w = (b=1)
        reveal_type(e1)
        reveal_type(e2)
        reveal_type(train())
        reveal_type(e3)
        reveal_type(e4)
        """,
        tmp_path,
    )
    assert verdicts[26] == 'Type of "e1" is "(name: str, age: str | int)"'  # field types: a union
    assert verdicts[27] == 'Type of "e2" is "(...)"'  # the `except` adds a field
    assert verdicts[28] == 'Type of "train()" is "(lr: float, steps: int, seed: int)"'
    assert verdicts[29] == 'Type of "e3" is "(name: str, age: int)"'
    assert verdicts[30] == 'Type of "e4" is "(a: int) | (...)"'  # the loop's next pass reads `w = (b=1)`


def test_replace_updates_a_record_and_a_spread_builds_a_new_one(tmp_path):
    # both copy with a field changed; _replace keeps the record's type, a spread makes whatever it's given
    r = (name="rahul", age=26)
    assert r._replace(age=r.age + 1) == (**r, age=r.age + 1) == (name="rahul", age=27)
    verdicts = checker(
        """\
        r = (name="rahul", age=26)
        r._replace(agee=27)
        r._replace(age="27")
        typo = (**r, agee=27)
        reveal_type(typo)
        retyped = (**r, age="27")
        reveal_type(retyped)
        """,
        tmp_path,
    )
    assert verdicts[2].startswith('No parameter named "agee"')  # a typo
    assert 'cannot be assigned to parameter "age" of type "int"' in verdicts[3]  # another type
    assert sorted(verdicts) == [2, 3, 5, 7]  # the spreads themselves are fine
    assert verdicts[5] == 'Type of "typo" is "(name: str, age: int, agee: int)"'  # a new field, silently
    assert verdicts[7] == 'Type of "retyped" is "(name: str, age: str)"'  # a new type, silently


type Contact = (name: str, age: int, surname: str, city: str)


def mail(to: Contact) -> str:
    return f"{to.name} {to.surname}, {to.city}"


def test_a_spread_is_checked_against_the_type_expected_where_it_stands(tmp_path):
    person, place = (name="ann", age=30), (surname="lee", city="oslo")
    c: Contact = (**person, **place)  # noqa: B008 -- see open_issues.md
    assert mail((**person, **place)) == mail(c) == "ann lee, oslo"  # noqa: B008 -- see open_issues.md
    verdicts = checker(
        """\
        type Contact = (name: str, age: int, surname: str, city: str)
        def mail(to: Contact) -> str: ...
        person = (name="ann", age=30)
        def contact_of_person() -> Contact:
            return (**person,)
        c: Contact = (**person, city="oslo")
        mail((**person, surname="lee", city="oslo", zip=1))
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [5, 6, 7]
    assert "missing fields: city, surname" in verdicts[5]  # against the return type
    assert "missing field: surname" in verdicts[6]  # against the annotation
    assert "extra field: zip" in verdicts[7]  # against the parameter


# `**rest` in a pattern: the fields not named, as a record. The other way round from building one,
# `(**rest, name=)`, and written the way `match` writes it for a dict: `case {"name": n, **rest}`


def test_rest_collects_the_fields_not_named_as_a_record():
    (name=, **rest) = (name="ann", age=30, city="oslo")
    assert name == "ann"
    assert rest == (age=30, city="oslo")


def test_rest_keeps_the_order_the_source_wrote_its_fields_in():
    (age=, **rest) = (city="oslo", age=30, name="ann")
    assert repr(rest) == "(city='oslo', name='ann')"


def test_take_a_few_fields_and_pass_the_rest_on():
    def model(*, n_layer: int, n_head: int) -> str:
        return f"{n_layer}x{n_head}"

    (lr=, **model_args) = (lr=3e-4, n_layer=6, n_head=8)
    assert (lr, model(**model_args)) == (3e-4, "6x8")


def test_rest_is_one_call_after_the_fields():
    assert (
        transform("(name=, age=a, **rest) = r").body
        == "_ds = r; name = _ds.name; a = _ds.age; rest = _byname_omit(_ds, ('age', 'name'))"
    )


def test_rest_in_loops_and_nested_patterns():
    rows = [(id=1, name="ann", age=30), (id=2, name="bo", age=4)]
    assert [data for (id=, **data) in rows if id == 2] == [(name="bo", age=4)]
    (user=(name=, **more), **top) = (user=(name="ann", age=30), ok=True)
    assert (name, more, top) == ("ann", (age=30), (ok=True))


def test_rest_can_be_empty_or_the_whole_record():
    r = (name="ann", age=30)
    (name=, age=, **empty) = r
    assert empty._asdict() == {} and repr(empty) == "()"
    (**whole) = r  # a copy, equal to r; `whole = r` says the same, records being immutable
    assert whole == r


def test_rest_targets_are_any_assignment_target():
    class Box:
        rest: object = None

    box = Box()
    (name=, **box.rest) = (name="ann", age=30)
    (name=, **_) = (name="ann", age=30)  # `_` is a name like any other, as in `first, *_ = xs`
    assert box.rest == (age=30)


def test_rest_takes_the_rest_of_a_record_only():
    # plain destructuring reads attributes, so it works on any object; a rest needs the record's field list
    @dataclass
    class D:
        name: str
        age: int

    with pytest.raises(TypeError, match="\\*\\*rest takes the rest of a record, not of D"):
        (name=, **rest) = D("ann", 30)  # pyright: ignore[reportArgumentType]


def test_rest_is_typed_from_the_source_s_record_type(tmp_path):
    verdicts = checker(
        """\
        type User = (name: str, age: int, city: str)
        def load() -> User: ...
        def make():
            return (name="a", age=1, score=2.5)
        def f(u: User, o: (..., name: str, age: int)) -> None:
            (name=, **r1) = load()
            (name=, **r2) = make()
            (name=, **r3) = o
            (name=, age=, city=, **r4) = u
            reveal_type(r1)
            reveal_type(r2)
            reveal_type(r3)
            reveal_type(r4)
            r1.name
            (name=, **r5) = u
            more = (**r5, zip=1)
            reveal_type(more)
        """,
        tmp_path,
    )
    assert verdicts[10] == 'Type of "r1" is "(age: int, city: str)"'  # an annotated return
    assert verdicts[11] == 'Type of "r2" is "(age: int, score: float)"'  # an inferred one
    assert verdicts[12] == 'Type of "r3" is "(..., age: int)"'  # an open type stays open
    assert verdicts[13] == 'Type of "r4" is "()"'
    assert verdicts[14].startswith('Cannot access attribute "name" for class "(age: int, city: str)"')
    # a rest of a name the file shows the fields of spreads back exactly (a rest of a call: see section 8's spreads)
    assert verdicts[17] == 'Type of "more" is "(age: int, city: str, zip: int)"'
    assert sorted(verdicts) == [10, 11, 12, 13, 14, 17]


def test_rest_of_a_record_made_in_an_imported_module_is_typed_too(tmp_path):
    # the shapes of the .pyn modules the file imports count as its own: an inferred return, an annotated
    # one, through an imported alias
    (tmp_path / "people.pyn").write_text(
        dedent(
            """\
            type User = (name: str, age: int, city: str)
            def make(name: str):
                return (name=, age=30, city="oslo")
            def load() -> User: ...
            """
        )
    )
    verdicts = checker(
        """\
        from people import User, load, make
        (name=, **r1) = make("ann")
        (name=, **r2) = load()
        u: User = load()
        (name=, **r3) = u
        reveal_type(r1)
        reveal_type(r2)
        reveal_type(r3)
        r1.age
        r1.agee
        s = (**u, zip=1)  # a spread translates the file twice: the second pass reads the imports too
        """,
        tmp_path,
    )
    for line, name in [(6, "r1"), (7, "r2"), (8, "r3")]:
        assert verdicts[line] == f'Type of "{name}" is "(age: int, city: str)"'
    assert sorted(verdicts) == [6, 7, 8, 10]  # r1.age is fine, r1.agee isn't
    assert verdicts[10].startswith('Cannot access attribute "agee"')


def test_rest_follows_imports_to_the_module_that_made_the_record(tmp_path):
    # people.pyn makes it, relay.pyn passes it on writing no shape: two imports away, and an import back
    # from people to relay (a cycle) ends the chain
    (tmp_path / "people.pyn").write_text(
        dedent(
            """\
            import relay
            def make():
                return (name="ann", age=30, city="oslo")
            """
        )
    )
    (tmp_path / "relay.pyn").write_text("from people import make\ndef make2():\n    return make()\n")
    verdicts = checker(
        """\
        from relay import make2
        (name=, **r) = make2()
        reveal_type(r)
        """,
        tmp_path,
    )
    assert verdicts == {3: 'Type of "r" is "(age: int, city: str)"'}


def test_rest_of_a_record_whose_fields_the_file_does_not_show_is_any_record(tmp_path):
    # the checker can't take fields out of a type, so byname builds the rest from the fields the file shows,
    # as a spread is built; where it shows none, the rest is (...), and byname says how to give it a type
    verdicts = checker(
        """\
        from dataclasses import dataclass
        from typing import Any
        @dataclass
        class D:
            name: str
        def f(x: Any, d: D) -> None:
            (name=, **r) = x
            reveal_type(r)
            (name=, **s) = d
        """,
        tmp_path,
    )
    assert verdicts[7].startswith("r is (...), any record, unchecked: byname can't tell the fields")
    assert verdicts[8] == 'Type of "r" is "(...)"'
    assert '"D" is not a record: **rest takes the rest of a record' in verdicts[9]


def test_a_rest_is_typed_wherever_the_checker_knows_its_record(tmp_path):
    # byname asks the checker what a record it can't read off the file is (a loop's item, `users[0]`, a method's
    # result), and the rest has the other fields. A record nobody gave a type is (...), with a hint; a type
    # written on the name, or declared before the loop or the branches binding it, gives the rest its fields
    verdicts = checker(
        """\
        type User = (name: str, age: int, city: str)
        def f(users: list[User], rows) -> None:
            for u in users:
                (name=, **r1) = u
                reveal_type(r1)
            (name=, **r2) = users.pop()
            reveal_type(r2)
            for (name=, **r3) in users:
                reveal_type(r3)
            w: User
            for w in rows:
                (name=, **r4) = w
                reveal_type(r4)
            (name=, **r5) = rows[0]
            reveal_type(r5)
            r: (..., name: str, age: int)  # bound to two shapes below: the declared type fits both
            if users:
                r = users[0]
            else:
                r = (name="b", age=2, zip=9)
            (name=, **r6) = r
            reveal_type(r6)
        """,
        tmp_path,
    )
    exact = 'is "(age: int, city: str)"'
    assert all(verdicts[n].endswith(exact) for n in [5, 7, 9])
    assert verdicts[13] == 'Type of "r4" is "(age: Unknown | int, city: Unknown | str)"'  # rows' items may be any
    assert verdicts[14].startswith("r5 is (...), any record, unchecked: byname can't tell the fields")
    assert verdicts[15] == 'Type of "r5" is "(...)"'
    assert verdicts[22] == 'Type of "r6" is "(..., age: int)"'
    assert sorted(verdicts) == [5, 7, 9, 13, 14, 15, 22]


# ============================================================================
# 9. WHAT BYNAME REJECTS, AND WHY
# ============================================================================


def test_a_field_cannot_start_with_an_underscore():
    with pytest.raises(SyntaxError, match="record field '_private' cannot start with '_'"):
        transform("r = (_private=1)\n")  # NamedTuple's rule: `_` names are its own (_replace, _asdict)


def test_keys_is_reserved_because_spreads_need_it():
    with pytest.raises(SyntaxError, match="records have a keys\\(\\) method, which lets `\\*\\*record` work"):
        transform("r = (keys=1)\n")


def test_a_field_appears_once():
    with pytest.raises(SyntaxError, match="duplicate record field in \\('a', 'a'\\)"):
        transform("r = (a=1, a=2)\n")


def test_a_pattern_reads_by_name_never_by_position():
    with pytest.raises(SyntaxError, match="pattern item 'a' needs '=': write a= or a=target"):
        transform("(a, b=) = r\n")


@pytest.mark.parametrize(
    ("src", "msg"),
    [
        ("(**rest, name=) = u\n", "`\\*\\*rest` goes last in a pattern"),  # as in `match`: what's left is what comes last
        ("(name=, **a, **b) = u\n", "`\\*\\*rest` goes last in a pattern"),  # so there's one
        ("(name=, **f()) = u\n", "cannot bind the rest to 'f\\(\\)'"),
        ("(name=, 1, **rest) = u\n", "a pattern takes `field=`, `field=target` and a last `\\*\\*rest`"),
    ],
)
def test_a_rest_goes_last_into_an_assignment_target(src, msg):
    with pytest.raises(SyntaxError, match=msg):
        transform(src)


def test_a_spread_record_takes_only_spreads_and_named_fields():
    with pytest.raises(SyntaxError, match="takes `\\*\\*record` and `name=value` items"):
        transform("r = (**u, 1)\n")


@pytest.mark.parametrize(
    "src",
    [
        'u = (name: str, age: int)(name="r", age=1)\n',
        "c = (name: str, age: int)(**u)\n",
        "c = (..., name: str)(**u)\n",
    ],
)
def test_a_record_type_cannot_be_called(src):
    # a type alias can't be called, so an inline type isn't either: build the record and annotate the name,
    # `u: (name: str, age: int) = (name="r", age=1)`, or from a dict, record(T, d)
    with pytest.raises(SyntaxError, match="can't call a record type: write the record, \\(name=...\\), annotated"):
        transform(src)


def test_instead_of_calling_a_record_type_annotate_the_name_or_use_record(tmp_path):
    u: (name: str, age: int) = (name="r", age=1)
    c: (name: str, age: int) = (**u)
    d = record((name: str, age: int), {"name": "r", "age": 1})  # an inline type stands as a value here
    assert u == c == d == (name="r", age=1)
    with pytest.raises(TypeError, match="age"):
        record((name: str, age: int), {"name": "r", "age": "one"})
    verdicts = checker(
        """\
        from byname import record
        u: (name: str, age: int) = (name="r", age=1)
        c: (name: str, age: int) = (**u)
        d = record((name: str, age: int), {"name": "r", "age": 1})
        reveal_type(d)
        e: (name: str, age: int) = (name="r")
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [5, 6]
    assert verdicts[5] == 'Type of "d" is "(name: str, age: int)"'
    assert "missing field: age" in verdicts[6]


def test_shorthand_is_for_call_sites_not_def_signatures():
    with pytest.raises(SyntaxError, match="expected default value expression"):
        to_code("def f(name=): ...\n", "x.pyn")  # it would mean "default to the outer name"


def test_destructuring_reads_attributes_so_a_dict_does_not_destructure(tmp_path):
    src = '(name=) = {"name": "rahul"}\n'
    assert checker(src, tmp_path) == {
        1: 'Cannot access attribute "name" for class "dict[str, str]"\nAttribute "name" is unknown (reportAttributeAccessIssue)'
    }
    with pytest.raises(AttributeError, match="'dict' object has no attribute 'name'"):
        exec(to_code(src, "x.pyn"), {})  # noqa: S102 -- running the rejected line


def test_a_method_does_not_destructure(tmp_path):
    # `(append=) = users` would bind `users` into `append` out of sight, as TypeScript's `const { push } = arr`
    # loses `this`: a pattern takes data, so call a method on its object. The checker says so; nothing at runtime
    verdicts = checker(
        """\
        import os
        from dataclasses import dataclass
        from typing import Callable
        @dataclass
        class User:
            name: str
            email: str
            act: Callable[[int], int]
            @property
            def domain(self) -> str: return self.email.split("@")[1]
            @staticmethod
            def zero() -> int: return 0
            def greet(self) -> str: return f"hi {self.name}"
        u = User("ann", "ann@x.com", abs)
        (name=, domain=, act=, zero=) = u
        (join=) = os.path
        (greet=) = User
        users = [1, 2]
        (append=) = users
        (greet=hi) = u
        for (upper=) in ["a"]: pass
        (user=(_replace=)) = (user=(name="ann"))
        """,
        tmp_path,
    )
    # data, a property, a function in a field, a staticmethod, a module's function: no object bound in. Nor in a
    # method read off its class: `greet(u)` passes `self` where it's seen
    appended, renamed, looped, nested = 19, 20, 21, 22
    assert verdicts == {
        appended: 'can\'t destructure the method "append": call it on its object, obj.append(...) (reportArgumentType)',
        renamed: 'can\'t destructure the method "greet": call it on its object, obj.greet(...) (reportArgumentType)',
        looped: 'can\'t destructure the method "upper": call it on its object, obj.upper(...) (reportArgumentType)',
        nested: 'can\'t destructure the method "_replace": call it on its object, obj._replace(...) (reportArgumentType)',
    }
    users = [1, 2]
    (append=) = users  # pyright: ignore[reportArgumentType]
    append(3)
    assert users == [1, 2, 3]  # Python binds it fine: the rule is about reading, not a crash


# ============================================================================
# 10. ALL TOGETHER, OVERLOADS, AND `*record`
# ============================================================================


def area(*, w: float, h: float):
    a = w * h
    perimeter = 2 * (w + h)
    return (a=, perimeter=)


def test_call_by_name_return_a_record_destructure_it():
    w, h = 3.0, 4.0
    (a=, perimeter=p) = area(w=, h=)
    assert (a, p) == (12.0, 14.0)


@overload
def lookup(key: int) -> int: ...
@overload
def lookup(key: Contact) -> str: ...
def lookup(key: int | Contact) -> int | str:
    return key if isinstance(key, int) else key.name


def test_a_spread_record_picks_the_overload_that_takes_a_record(tmp_path):
    person, place = (name="ann", age=30), (surname="lee", city="oslo")
    assert lookup((**person, **place)) == "ann"  # noqa: B008 -- see open_issues.md
    assert lookup(7) == 7
    verdicts = checker(
        """\
        from typing import overload
        type Contact = (name: str, age: int, surname: str, city: str)
        @overload
        def lookup(key: int) -> int: ...
        @overload
        def lookup(key: Contact) -> str: ...
        def lookup(key: int | Contact) -> int | str: ...
        person, place = (name="ann", age=30), (surname="lee", city="oslo")
        reveal_type(lookup((**person, **place)))
        """,
        tmp_path,
    )
    # the Contact overload; the quoted call is generated code, see open_issues.md
    assert verdicts[9].endswith('is "str"')


# Records can't be told apart at runtime, so `isinstance` can't narrow a union of them, and neither can `in`
# (open_issues.md). A field typed with a different Literal in each record can, like `kind` below
type Square = (kind: Literal["square"], side: float)
type Circle = (kind: Literal["circle"], radius: float)


@overload
def describe(shape: Square) -> int: ...
@overload
def describe(shape: Circle) -> str: ...
def describe(shape: Square | Circle) -> int | str:
    if shape.kind == "square":  # shape is Square here, and Circle after
        return round(shape.side**2)
    return f"circle of radius {shape.radius}"


def test_overloads_on_two_record_types_pick_by_shape(tmp_path):
    sq: Square = (kind="square", side=3.0)
    ci: Circle = (kind="circle", radius=2.0)
    assert describe(sq) == 9
    assert describe(ci) == "circle of radius 2.0"
    verdicts = checker(
        """\
        from typing import Literal, overload
        type Square = (kind: Literal["square"], side: float)
        type Circle = (kind: Literal["circle"], radius: float)
        @overload
        def describe(shape: Square) -> int: ...
        @overload
        def describe(shape: Circle) -> str: ...
        def describe(shape: Square | Circle) -> int | str: ...
        sq: Square = (kind="square", side=3.0)
        reveal_type(describe(sq))
        reveal_type(describe((kind="circle", radius=2.0)))
        loose = (kind="circle", radius=2.0)
        describe(loose)
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [10, 11, 13]
    assert verdicts[10].endswith('is "int"')
    assert verdicts[11].endswith('is "str"')  # a literal passed straight in is read as the parameter's type
    # a literal stored first is widened to kind: str, so it fits neither; annotate it, `loose: Circle = ...`
    assert "No overloads" in verdicts[13]


def test_a_literal_tag_narrows_a_union_of_records(tmp_path):
    shapes: list[Square | Circle] = [(kind="square", side=3.0), (kind="circle", radius=2.0)]
    assert [describe(shape) for shape in shapes] == [9, "circle of radius 2.0"]
    verdicts = checker(
        """\
        from typing import Literal
        type Square = (kind: Literal["square"], side: float)
        type Circle = (kind: Literal["circle"], radius: float)
        shapes: list[Square | Circle] = [(kind="square", side=3.0), (kind="circle", radius=2.0)]
        for shape in shapes:
            if shape.kind == "square":
                reveal_type(shape)
            else:
                reveal_type(shape)
            match shape.kind:
                case "square":
                    print(shape.side)
                case "circle":
                    print(shape.radius)
            if "side" in shape:
                print(shape.side)
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [7, 9, 16]  # nothing from the match, because each case narrows too
    assert verdicts[7].endswith("is \"(kind: Literal['square'], side: float)\"")
    assert verdicts[9].endswith("is \"(kind: Literal['circle'], radius: float)\"")
    assert 'Cannot access attribute "side"' in verdicts[16]  # `in` doesn't narrow, see open_issues.md


def pair(name: str, age: int) -> str:
    return f"{name}:{age}"


def test_a_record_spreads_into_a_call_by_name_not_position(tmp_path):
    assert pair(**(age=30, name="ann")) == "ann:30"
    verdicts = checker(
        """\
        def pair(name: str, age: int) -> str: ...
        pair(*(age=30, name="ann"))
        pair(**(age=30, name="ann"))
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [2]
    assert "is not iterable" in verdicts[2]


# ============================================================================
# 11. FROM A DICT AND BACK: `record(T, d)`, checked at runtime, and `deepdict(rec)`
# ============================================================================

# A dict's keys aren't known statically, so the checker rejects `(**d)` into a record type, and at runtime
# it would build whatever keys `d` has. Data loaded from a file arrives as a dict: `record(T, d)` turns it
# into a T, checking every field at runtime, and the checker types the call as T.

type ModelConfig = (n_layer: int, dropout: float)


def test_record_builds_the_record_its_literal_would():
    saved = {"n_layer": 4, "dropout": 0.2}  # say, from torch.load or json.loads
    cfg = record(ModelConfig, saved)
    assert cfg == (n_layer=4, dropout=0.2)


def test_record_is_typed_as_the_type_it_names(tmp_path):
    verdicts = checker(
        """\
        from byname import record
        type ModelConfig = (n_layer: int, dropout: float)
        cfg = record(ModelConfig, {"n_layer": 4, "dropout": 0.2})
        reveal_type(cfg)
        cfg.n_layr
        """,
        tmp_path,
    )
    assert verdicts[4] == 'Type of "cfg" is "(n_layer: int, dropout: float)"'
    assert verdicts[5].startswith('Cannot access attribute "n_layr"')


def test_record_names_every_bad_field_at_once():
    saved = {"n_layer": "4", "dropuot": 0.2}
    with pytest.raises(TypeError) as e:
        record(ModelConfig, saved)
    assert str(e.value) == (
        "ModelConfig: field 'n_layer': expected int, got str ('4'); missing field 'dropout'; unexpected field 'dropuot'"
    )


def test_a_file_saved_before_a_field_existed_gets_it_from_the_left():
    saved = {"n_layer": 4}  # written before ModelConfig had dropout
    # dict order: the left is the default, the right (what the file holds) wins
    cfg = record(ModelConfig, {"dropout": 0.0, **saved})
    assert cfg == (n_layer=4, dropout=0.0)


def test_a_field_can_be_overridden_from_the_right():
    saved = {"n_layer": 4, "dropout": 0.2}  # trained with dropout
    # the right wins: reuse a saved config with one field changed, say fine-tuning without dropout
    cfg = record(ModelConfig, {**saved, "dropout": 0.0})
    assert cfg == (n_layer=4, dropout=0.0)


# The other way: `_asdict()`, `dict(rec)` and `{**rec}` convert one level, as NamedTuple's `_asdict()` does,
# so a nested record stays a record, which json.dumps and torch.load(weights_only=True) refuse.
# `deepdict(rec)` makes dicts all the way down, as `deepcopy` copies all the way down where `copy` stops.

type Schedule = (warmup_steps: int, max_lr: float)
type EvalRow = (step: int, val_loss: float)
type TrainConfig = (batch_size: int, schedule: Schedule)
type Run = (cfg: TrainConfig, history: list[EvalRow])


def test_asdict_is_one_level_so_json_refuses_a_nested_record():
    cfg: TrainConfig = (batch_size=64, schedule=(warmup_steps=200, max_lr=5e-4))
    assert cfg._asdict()["schedule"] == (warmup_steps=200, max_lr=5e-4)  # still a record
    with pytest.raises(TypeError):
        json.dumps(cfg._asdict())


def test_deepdict_makes_dicts_all_the_way_down():
    cfg: TrainConfig = (batch_size=64, schedule=(warmup_steps=200, max_lr=5e-4))
    assert deepdict(cfg) == {"batch_size": 64, "schedule": {"warmup_steps": 200, "max_lr": 5e-4}}
    assert json.dumps(deepdict(cfg)) == '{"batch_size": 64, "schedule": {"warmup_steps": 200, "max_lr": 0.0005}}'


def test_record_of_deepdict_gives_the_record_back_lists_of_records_too():
    # record() builds the records in a list[R], tuple[R, ...] or dict[K, R] field, so a run's history
    # survives being saved as plain data
    run: Run = (cfg=(batch_size=64, schedule=(warmup_steps=200, max_lr=5e-4)), history=[(step=0, val_loss=2.1)])
    saved = json.loads(json.dumps(deepdict(run)))
    assert record(Run, saved) == run


def test_deepdict_takes_a_record_and_gives_a_dict_to_the_checker(tmp_path):
    verdicts = checker(
        """\
        from byname import deepdict
        cfg = (batch_size=64, schedule=(warmup_steps=200, max_lr=5e-4))
        reveal_type(deepdict(cfg))
        deepdict([cfg])
        """,
        tmp_path,
    )
    record_given, list_given = 3, 4
    assert verdicts[record_given] == 'Type of "deepdict(cfg)" is "dict[str, Any]"'
    # a list of records is [deepdict(row) for row in rows]
    assert verdicts[list_given].startswith('Argument of type "list[')


# ============================================================================
# 12. ANY PYTHON IMPORTS A .pyn: byname.pth installs the import hook in every interpreter of the venv
# ============================================================================
# not only `byname run`, pytest and `%load_ext byname`: plain `python`, `python -m`, a plain notebook's kernel,
# a debugger, multiprocessing's spawned workers (DataLoader's). Next to it, `both.pyn` wins over `both.py`.


def python(tmp_path: Path, *args: str) -> str:
    out = subprocess.run([sys.executable, *args], cwd=tmp_path, capture_output=True, text=True, check=False)
    assert out.returncode == 0, out.stderr
    return out.stdout


def test_plain_python_imports_a_pyn_module(tmp_path):
    (tmp_path / "shapes.pyn").write_text("def box(): return (w=2, h=3)\nif __name__ == '__main__': print(box())\n")
    assert python(tmp_path, "-c", "import shapes; print(shapes.box().w)") == "2\n"
    assert python(tmp_path, "-m", "shapes") == "(w=2, h=3)\n"


def test_a_pyn_wins_over_a_py_of_the_same_name(tmp_path):
    # as the editor resolves it
    (tmp_path / "both.py").write_text("WHO = 'py'\n")
    (tmp_path / "both.pyn").write_text("WHO = (who='pyn').who\n")
    assert python(tmp_path, "-c", "import both; print(both.WHO)") == "pyn\n"


def test_a_package_s_init_can_be_a_pyn(tmp_path):
    (tmp_path / "pynpkg").mkdir()
    (tmp_path / "pynpkg" / "__init__.pyn").write_text("WHO = (who='pkg').who\n")
    assert python(tmp_path, "-c", "from pynpkg import WHO; print(WHO)") == "pkg\n"


def test_a_spawned_worker_imports_a_pyn_module(tmp_path):
    # DataLoader workers: the worker imports the function's module afresh, and the record comes back pickled
    (tmp_path / "work.pyn").write_text("def step(i): return (i=i, sq=i * i)\n")
    (tmp_path / "main.py").write_text(
        dedent("""\
        import multiprocessing as mp
        import work
        if __name__ == "__main__":
            with mp.get_context("spawn").Pool(1) as pool:
                print(pool.map(work.step, [2, 3]))
        """)
    )
    assert python(tmp_path, "main.py") == "[(i=2, sq=4), (i=3, sq=9)]\n"


def test_a_python_that_never_loads_a_pyn_does_not_load_the_translator(tmp_path):
    # the hook is in every interpreter of the venv, so it must cost next to nothing until a .pyn is loaded
    imported = python(tmp_path, "-c", "import sys; print(sorted(m for m in sys.modules if m.startswith('byname')))")
    assert imported == "['byname', 'byname.hook']\n"
