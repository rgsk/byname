# Every byname feature, read top to bottom. One rule for all of them: in `field=value` the left is the
# field or parameter name and the right is your local; a bare `field=` means `field=field`.

import copy
import json
import os
import pickle
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from textwrap import dedent
from typing import Literal, overload

import pytest

from byname import record, to_code, transform

# ============================================================================
# 1. CALLS: pass locals by name
# ============================================================================


def greet(*, name: str, age: int, loud: bool = False) -> str:
    s = f"{name} is {age}"
    return s.upper() if loud else s


def test_a_bare_keyword_passes_the_local_of_the_same_name():
    name, age = "rahul", 26
    assert greet(name=, age=) == "rahul is 26"


def test_it_is_only_the_keyword_written_twice():
    assert transform("greet(name=, age=)").body == "greet(name=name, age=age)"


def test_shorthand_mixes_with_explicit_values():
    name, age = "rahul", 26
    assert greet(name=, age=age + 1) == "rahul is 27"
    assert greet(name=, age=, loud=True) == "RAHUL IS 26"


def test_shorthand_goes_after_positional_arguments_and_with_kwargs():
    def tag(prefix: str, *, name: str, loud: bool = False) -> str:
        return f"{prefix}:{name}" + "!" * loud

    name = "rahul"
    opts = {"loud": True}
    assert tag("user", name=) == "user:rahul"
    assert tag("user", name=, **opts) == "user:rahul!"


def test_any_callable_takes_it_methods_and_builtins_too():
    class Greeter:
        def hello(self, *, name: str) -> str:
            return f"hello {name}"

    name, age = "rahul", 26
    assert Greeter().hello(name=) == "hello rahul"
    assert dict(name=, age=) == {"name": "rahul", "age": 26}  # noqa: C408 -- a builtin call is the point


def test_order_never_matters_because_every_argument_is_named():
    age, name = 26, "rahul"
    assert greet(age=, name=) == greet(name=, age=) == "rahul is 26"


# ============================================================================
# 2. RECORDS: build a value from locals by name
# ============================================================================


def make(*, name: str, age: int):
    greeting = f"hi {name}"
    return (name=, age=, greeting=)


def test_a_record_is_built_from_locals_by_name():
    name, age = "rahul", 26
    r = (name=, age=)
    assert (r.name, r.age) == ("rahul", 26)


def test_a_function_returns_its_locals_by_name():
    r = make(name="rahul", age=26)
    assert (r.name, r.age, r.greeting) == ("rahul", 26, "hi rahul")


def test_it_is_a_call_to_a_class_named_after_its_fields():
    assert transform("(name=, age=)").body == "_rec_name__age(name=name, age=age)"


def test_fields_take_explicit_values_and_any_expression():
    name = "rahul"
    r = (name=name.upper(), score=10 * 9)
    assert (r.name, r.score) == ("RAHUL", 90)


def test_one_field_needs_no_trailing_comma():
    name = "rahul"
    assert (name=).name == "rahul"
    assert (name) == "rahul"  # no `=`: plain parentheses
    assert transform("(name=)").body == "_rec_name(name=name)"


def test_a_trailing_comma_changes_nothing_but_the_formatting():
    name = "rahul"
    short = (name=)
    split = (
        name=,
    )  # the trailing comma keeps the formatter from joining it
    assert short.name == split.name == "rahul"
    assert short._fields == split._fields == ("name",)


def test_a_long_record_spans_lines():
    name, age = "rahul", 26
    r = (
        name=,
        age=,
    )
    assert r.age == 26


def test_records_nest_and_go_anywhere_an_expression_can():
    name, age = "rahul", 26
    nested = (user=(name=, age=), ok=True)
    rows = [(i=, square=i * i) for i in range(3)]
    double = lambda x: (x=, twice=x * 2)
    assert nested.user.name == "rahul"
    assert repr(nested) == "(user=(name='rahul', age=26), ok=True)"
    assert [r.square for r in rows] == [0, 1, 4]
    assert repr(rows) == "[(i=0, square=0), (i=1, square=1), (i=2, square=4)]"
    assert double(5).twice == 10
    assert repr(double(5)) == str(double(5)) == "(x=5, twice=10)"
    assert repr((name=, age=)) == str((name=, age=)) == "(name='rahul', age=26)"  # as a call argument


# ============================================================================
# 3. WHAT A RECORD IS: fields read by name, never by position
# ============================================================================


def test_a_record_is_read_by_name_only(tmp_path):
    # field order never matters, so nothing reads a record by position: reorder a record's fields where
    # it's built and no reader changes meaning. Want positions? Return a tuple.
    verdicts = checker(
        """\
        def get_batch():
            return (x=1, y=2)
        r = get_batch()
        x, y = r
        r[0]
        for v in r: pass
        print(*r)
        sorted([r, r])
        (x=, y=) = r
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [4, 5, 6, 7, 8]  # line 9, by name, is the way
    assert verdicts[4].startswith('"(x: int, y: int)" is not iterable')
    assert verdicts[5].startswith('Argument of type "Literal[0]" cannot be assigned to parameter "k" of type "str"')
    assert "records are read by name: (x=, y=)" in verdicts[5]
    assert "records have no order: compare or sort by a field (key=lambda r: r.x)" in verdicts[8]


def test_at_runtime_a_record_is_a_named_tuple_stored_by_name():
    # a NamedTuple underneath (immutable, hashable, cheap), with its fields stored sorted by name and shown in
    # the order written
    r = (name="rahul", age=26)
    assert isinstance(r, tuple) and len(r) == 2
    assert r._fields == ("age", "name")
    assert tuple(r.keys()) == ("name", "age")  # what `**r` reads
    assert list(r._asdict()) == ["name", "age"]


def test_reading_by_position_raises_at_runtime_too():
    # the stored order is sorted by name, so anything positional would read an order nobody wrote
    r = (name="rahul", age=26)
    with pytest.raises(TypeError, match="read by name only"):
        _first, _second = r  # pyright: ignore[reportGeneralTypeIssues]
    with pytest.raises(TypeError, match="read by name only"):
        list(r)  # pyright: ignore[reportArgumentType]
    with pytest.raises(TypeError, match="read by name only"):
        _ = r[0]  # pyright: ignore[reportArgumentType]
    with pytest.raises(TypeError, match="read by name only"):
        _ = r + ()  # pyright: ignore[reportOperatorIssue]


def test_records_have_no_order():
    with pytest.raises(TypeError, match="'<' not supported"):
        sorted([(name="rahul", age=26), (name="tasha", age=22)])  # pyright: ignore[reportArgumentType]
    # order by a field
    assert min([(name="rahul", age=26), (name="tasha", age=22)], key=lambda u: u.age).name == "tasha"


def test_in_asks_for_a_field_name_like_a_dict(tmp_path):
    r = (name="rahul", age=26)
    assert "name" in r
    assert "rahul" not in r  # values aren't searched
    # allowed, but it doesn't narrow a union of records the way it narrows TypedDicts (see open_issues.md)
    assert checker('ok = "name" in (name="rahul")\n', tmp_path) == {}


def test_mappings_and_json_go_through_the_field_names():
    r = (name="rahul", age=26)
    assert {**r} == {"name": "rahul", "age": 26}
    # what `**r` reads, so they work at runtime; the checker rejects both (no `rec[...]`): use {**r}
    assert r["name"] == "rahul"  # pyright: ignore[reportIndexIssue]
    assert dict(r) == {**r}  # pyright: ignore[reportCallIssue, reportArgumentType]
    assert json.dumps({**r}) == '{"name": "rahul", "age": 26}'
    with pytest.raises(TypeError):
        json.dumps(r)  # json writes any tuple as a list, and a record won't be read as one


def test_pickle_and_copy_keep_a_record():
    r = (name="rahul", age=26)
    assert pickle.loads(pickle.dumps(r)) == copy.copy(r) == copy.deepcopy(r) == r
    assert repr(copy.deepcopy(r)) == "(name='rahul', age=26)"


def test_each_field_list_gets_one_class():
    r = (name="rahul", age=26)
    assert type(r).__name__ == "_rec_name__age"
    assert type(r) is type((name="tasha", age=23))
    assert type(r) is type((name=23, age="tasha"))  # value types live only in the checker: (name: int, age: str)
    assert type(r) is not type((age=23, name="tasha"))  # another order, another class


def test_a_record_is_immutable():
    r = (name="rahul", age=26)
    with pytest.raises(AttributeError):
        r.age = 27  # pyright: ignore[reportAttributeAccessIssue]


def test_replace_copies_with_some_fields_changed():
    r = (name="rahul", age=26)
    older = r._replace(age=27)
    assert (older.name, older.age) == ("rahul", 27)
    assert r.age == 26
    with pytest.raises(ValueError, match="agee"):
        r._replace(agee=27)  # pyright: ignore[reportCallIssue]


def test_asdict_gives_the_fields_in_written_order():
    assert (name="rahul", age=26)._asdict() == {"name": "rahul", "age": 26}


def test_equality_compares_fields_by_name_in_any_order():
    assert (name="rahul", age=26) == (age=26, name="rahul")
    assert (name="rahul", age=26) != (name="rahul", agee=26)  # another field set
    assert (name="rahul", age=26) != ("rahul", 26)  # never equal to a plain tuple
    assert ("rahul", 26) != (name="rahul", age=26)


def test_a_record_is_hashable_so_it_can_be_a_dict_key():
    seen = {(name="rahul", age=26): "found"}
    assert seen[(name="rahul", age=26)] == "found"
    assert seen[(age=26, name="rahul")] == "found"  # equal records hash alike


def lo_hi(xs: list[int]):
    lo, hi = min(xs), max(xs)
    return lo, hi


def test_a_returned_tuple_shows_the_names_it_was_returned_from(tmp_path):
    # Want positions? Return a tuple: hover labels each position with the name returned there, so the order
    # is documented with nothing written. A plain tuple at runtime, read by position as usual.
    lo, hi = lo_hi([3, 1, 2])
    assert (lo, hi) == (1, 3) and type(lo_hi([1])) is tuple
    verdicts = checker(
        """\
        def get_batch(n: int):
            x, y = [n], "s"
            return x, y.upper()
        def lo_hi(n: int):
            lo, hi = n, n + 1
            return lo, hi
        def annotated(n: int) -> tuple[int, int]:
            lo = n
            return lo, lo
        reveal_type(get_batch)
        reveal_type(lo_hi)
        reveal_type(annotated)
        lo, hi = lo_hi(1)
        reveal_type(hi)
        lo_hi(1).hi
        def moved(x: list[int], y: list[int]):
            return (x := x * 2, y := y * 2)  # a walrus labels its position too
        reveal_type(moved)
        """,
        tmp_path,
    )
    assert verdicts[10] == 'Type of "get_batch" is "(n: int) -> tuple[x: list[int], str]"'  # `y.upper()` isn't a name
    assert verdicts[11] == 'Type of "lo_hi" is "(n: int) -> tuple[lo: int, hi: int]"'
    assert verdicts[12] == 'Type of "annotated" is "(n: int) -> tuple[int, int]"'  # what's written wins
    assert verdicts[14] == 'Type of "hi" is "int"'
    assert verdicts[15].startswith('Cannot access attribute "hi"')  # labels are for reading, not attributes
    assert verdicts[18] == 'Type of "moved" is "(x: list[int], y: list[int]) -> tuple[x: list[int], y: list[int]]"'


# ============================================================================
# 4. DESTRUCTURING: bind fields to locals by name
# ============================================================================


def test_destructuring_binds_fields_to_locals_by_name():
    (name=, age=) = (name="rahul", age=26)
    assert (name, age) == ("rahul", 26)


def test_it_is_one_attribute_read_per_field():
    assert transform("(name=, age=years) = r").body == "_ds = r; name = _ds.name; years = _ds.age"


def test_fields_come_out_in_any_order_and_any_subset():
    (age=, name=) = (name="rahul", age=26, greeting="hi rahul")
    (greeting=) = (name="rahul", age=26, greeting="hi rahul")
    assert (name, age, greeting) == ("rahul", 26, "hi rahul")


def test_a_field_can_be_renamed_into_another_local():
    (name=who, age=years) = (name="rahul", age=26)
    assert (who, years) == ("rahul", 26)


def test_one_field_can_go_into_two_locals():
    (name=, name=alias) = (name="rahul", age=26)
    assert name == alias == "rahul"


def test_targets_can_be_attributes_and_subscripts():
    class Box:
        label = ""

    box, ages = Box(), {}
    (name=box.label, age=ages["rahul"]) = (name="rahul", age=26)
    assert (box.label, ages) == ("rahul", {"rahul": 26})


def test_renaming_both_ways_swaps_two_locals():
    a, b = 1, 2
    (a=b, b=a) = (a=, b=)
    assert (a, b) == (2, 1)


def test_a_long_pattern_spans_lines():
    (
        name=,
        age=,
    ) = (name="rahul", age=26)
    assert (name, age) == ("rahul", 26)


def test_any_object_with_attributes_destructures():
    @dataclass
    class User:
        name: str
        email: str

    (real=re, imag=im) = 3 + 4j  # builtins
    (email=) = User("rahul", "rahul@x.com")  # dataclasses
    (sep=, curdir=) = os  # modules
    assert (re, im, email, sep, curdir) == (3.0, 4.0, "rahul@x.com", "/", ".")


def test_a_method_can_unpack_self_and_fill_many_attributes():
    class Point:
        def __init__(self, x: int, y: int):
            (x=self.x, y=self.y) = (x=, y=)

        def norm2(self) -> int:
            (x=, y=) = self
            return x * x + y * y

    assert Point(3, 4).norm2() == 25


# ============================================================================
# 5. DESTRUCTURING IN LOOPS AND NESTED PATTERNS
# ============================================================================


def test_a_for_loop_destructures_each_record():
    people = [(name="rahul", age=26), (name="tasha", age=23)]
    seen = []
    for (name=, age=years) in people:
        seen.append(f"{name}:{years}")
    assert seen == ["rahul:26", "tasha:23"]


def test_the_loop_reads_fields_through_a_generator():
    assert (
        transform("for (name=, age=years) in people: pass").body
        == "for (name, years) in ((_ds.name, _ds.age) for _ds in people): pass"
    )


def test_comprehensions_destructure_the_same_way():
    people = [(name="rahul", age=26), (name="tasha", age=23)]
    assert [f"{name}:{age}" for (name=, age=) in people] == ["rahul:26", "tasha:23"]
    assert {name: age for (name=, age=) in people} == {"rahul": 26, "tasha": 23}


def test_a_pattern_is_written_like_the_record_it_takes_apart():
    local_name = "rahul"
    r = (user=(name=local_name))  # build
    del local_name
    (user=(name=local_name)) = r  # take apart, the same text on the other side
    assert local_name == "rahul"


def test_a_nested_pattern_reads_through_the_outer_field():
    (user=(name=, age=years), ok=) = (user=(name="rahul", age=26), ok=True)
    assert (name, years, ok) == ("rahul", 26, True)


def test_nesting_is_a_chain_of_attribute_reads():
    assert transform("(user=(name=), ok=) = r").body == "_ds = r; name = _ds.user.name; ok = _ds.ok"


def test_loops_take_nested_patterns_too():
    rows = [(user=(name="rahul"), ok=True), (user=(name="tasha"), ok=False)]
    assert [name for (user=(name=), ok=) in rows if ok] == ["rahul"]


# ============================================================================
# 6. RECORD TYPES: written the way hover shows them
# ============================================================================


def checker(src: str, tmp_path: Path) -> dict[int, str]:
    # basedpyright's verdicts on `src` by line (errors and reveal_type notes); one line's messages split by a blank line
    (tmp_path / "snippet.pyn").write_text(dedent(src))
    run = [sys.executable, "-m", "byname", "tool", "basedpyright", "snippet.pyn"]
    out = subprocess.run(run, cwd=tmp_path, capture_output=True, text=True, check=False).stdout
    verdicts: dict[int, str] = {}
    line = 0
    for row in out.splitlines():
        if m := re.match(r"\s*snippet\.pyn:(\d+):\d+ - \w+: (.*)", row):
            line = int(m[1])
            verdicts[line] = verdicts[line] + "\n\n" + m[2] if line in verdicts else m[2]
        elif line and row.startswith("  "):  # a message's next lines (indented with non-breaking spaces)
            verdicts[line] += "\n" + row.strip()
    return verdicts


type Person = (name: str, age: int)


def test_a_record_type_is_written_the_way_hover_shows_it():
    gil: Person = (age=30, name="gil")
    assert (gil.name, gil.age) == ("gil", 30)
    assert transform("type Person = (name: str, age: int)").body == "type Person = _typ_name__age[str, int]"


def test_a_record_type_types_a_record_but_does_not_build_one(tmp_path):
    # `type` makes a TypeAliasType, which Python doesn't call, so a type goes on the name: an annotation.
    # An inline type can't be called either (see section 9), so a type is used the same way, named or not
    a: Person = (name="gil", age=30)
    b: (name: str, age: int) = (name="gil", age=30)
    assert a == b
    with pytest.raises(TypeError, match="not callable"):
        Person(name="gil", age=30)  # pyright: ignore[reportCallIssue]
    verdicts = checker(
        """\
        type Person = (name: str, age: int)
        a: Person = (name="gil", age=30)
        c = Person(name="gil", age=30)
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [3]
    assert verdicts[3].startswith('Object of type "TypeAliasType" is not callable')


def test_a_record_type_takes_any_field_order_but_exactly_its_fields(tmp_path):
    verdicts = checker(
        """\
        type Person = (name: str, age: int)
        a: Person = (age=30, name="gil")
        b: Person = (name="gil", age=30, email="g@x")
        c: Person = (name="gil",)
        d: Person = (name="gil", age="thirty")
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [3, 4, 5]  # line 2, another order, is fine
    assert "extra field: email" in verdicts[3]
    assert "missing field: age" in verdicts[4]
    assert '"age" is an incompatible type' in verdicts[5]


def test_an_open_type_takes_at_least_its_fields(tmp_path):
    verdicts = checker(
        """\
        def age_of(p: (..., age: int)) -> int:
            return p.age
        age_of((name="ivy", age=7, tall=True))
        age_of((name="ivy",))
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [4]
    assert '"age" is not present' in verdicts[4]


def test_brackets_read_a_record_unchecked(tmp_path):
    # `rec.name` is checked; `rec["name"]` is the way around the checker: any str key, typed Any, also on an
    # open type or a union, and a KeyError at runtime if the field isn't there. `in` asks for a field name
    verdicts = checker(
        """\
        def greet(p: (..., name: str)) -> str:
            if "title" in p:
                return p["title"] + p.name
            return p.name
        anyone: (...) = (age=1)
        users = [(name="rahul"), (age=27)]
        print(greet((name="ivy", title="dr")), anyone["age"], users[0]["name"], users[1]["nmae"])
        print(anyone.keys(), dict(anyone), {**anyone})  # an open type is a record: keys() and `**` too
        """,
        tmp_path,
    )
    assert verdicts == {}
    r = (name="ivy", title="dr")
    assert r["title"] == "dr" and "title" in r
    with pytest.raises(KeyError):
        r["nmae"]


def test_an_open_type_takes_records_only(tmp_path):
    # unlike `.name`, `p["name"]` needs a mapping underneath: a dataclass or any other object won't do
    verdicts = checker(
        """\
        from dataclasses import dataclass
        @dataclass
        class D:
            age: int
        def age_of(p: (..., age: int)) -> int:
            return p.age
        age_of(D(age=1))
        age_of(3)
        def anything(p: (...)) -> None: ...
        anything(3)
        anything((a=1))
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [7, 8, 10]


def test_a_record_type_is_read_by_name_too(tmp_path):
    verdicts = checker(
        """\
        def get_batch() -> (x: int, y: int):
            return (y=2, x=1)
        x, y = get_batch()
        (x=, y=) = get_batch()
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [3]  # positionally, x would be 2 here: the type allows either order
    assert verdicts[3].startswith('"(x: int, y: int)" is not iterable')


def depth(n: int):  # hover: def depth(n: int) -> Unknown
    if n == 0:
        return (d=0)
    (d=) = depth(n - 1)
    return (d=d + 1)


def depth_typed(n: int) -> (d: int):  # hover: def depth_typed(n: int) -> (d: int)
    if n == 0:
        return (d=0)
    (d=) = depth_typed(n - 1)
    return (d=d + 1)


def test_a_recursive_function_writes_its_record_type():
    # hover the `.d`s: depth(3).d is `int | Unknown`, depth_typed(3).d is `int`
    assert depth(3).d == depth_typed(3).d == 3


def test_the_checker_infers_a_written_record_type(tmp_path):
    verdicts = checker(
        """\
        def depth(n: int):
            if n == 0:
                return (d=0)
            (d=) = depth(n - 1)
            return (d=d + 1)
        def depth_typed(n: int) -> (d: int):
            if n == 0:
                return (d=0)
            (d=) = depth_typed(n - 1)
            return (d=d + 1)
        reveal_type(depth)
        reveal_type(depth_typed)
        reveal_type(depth_typed(3).d)
        """,
        tmp_path,
    )
    assert (
        verdicts
        == {
            11: 'Type of "depth" is "(n: int) -> ((d: int) | (d: int | Unknown))"',  # inference can't see through the recursive call
            12: 'Type of "depth_typed" is "(n: int) -> (d: int)"',
            13: 'Type of "depth_typed(3).d" is "int"',
        }
    )


# 7. PARAMETERS: give the parameter a name, destructure it in the body
#    (no pattern in a signature: there `name=` is a default and nothing else; Python dropped tuple
#    parameters too, PEP 3113)
# ============================================================================


def intro(person: Person, loud: bool = False) -> str:
    (name=, age=) = person
    if loud:
        return f"{name.upper()}, {age}!"
    return f"{name}, {age}"


def test_a_parameter_is_destructured_first_in_the_body():
    assert intro((name="gil", age=30)) == "gil, 30"
    assert intro(person=(age=7, name="ivy"), loud=True) == "IVY, 7!"  # it has a name, so it passes by keyword


@pytest.mark.parametrize(
    "src",
    [
        "def f((name=, age=): Person): ...",
        "def f(x, (name=)): ...",
        "def f((id=, user=(name=n))): ...",
        "def f((name=) = (name='u')): ...",
        "def f[T]((name=): T): ...",
    ],
)
def test_a_pattern_in_a_signature_is_an_error(src):
    with pytest.raises(
        SyntaxError, match=r"can't destructure a parameter: give it a name and destructure it in the body"
    ):
        transform(src)


def test_shorthand_in_a_default_is_still_an_error():
    with pytest.raises(
        SyntaxError, match=r"name= in a parameter's default would take the outer 'name': write name=name"
    ):
        transform("def welcome(user=(name=)): ...")


# ============================================================================
# 8. SPREADS: `**record`, by field name, like `**dict`
# ============================================================================


def card(name: str, age: int, surname: str, city: str) -> str:
    return f"{name} {surname}, {age}, {city}"


def test_a_record_spreads_into_a_call_by_field_name():
    person, place = (name="ann", age=30), (surname="lee", city="oslo")
    assert card(**person, **place) == "ann lee, 30, oslo"


def test_a_record_spreads_into_a_dict():
    person, place = (name="ann", age=30), (surname="lee", city="oslo")
    assert {**person, **place} == {"name": "ann", "age": 30, "surname": "lee", "city": "oslo"}


def test_a_record_built_from_spreads_takes_the_later_field_in_the_first_position():
    defaults = (lr=1e-2, eval_iters=100)
    cfg = (**defaults, batch_size=32, lr=3e-3)
    assert repr(cfg) == "(lr=0.003, eval_iters=100, batch_size=32)"


def test_a_spread_of_known_records_is_typed_without_an_annotation(tmp_path):
    verdicts = checker(
        """\
        defaults = (lr=1e-2, eval_iters=100)
        cfg = (**defaults, batch_size=32)
        reveal_type(cfg)
        cfg.btach_size
        """,
        tmp_path,
    )
    assert verdicts[3] == 'Type of "cfg" is "(lr: float, eval_iters: int, batch_size: int)"'
    assert verdicts[4].startswith('Cannot access attribute "btach_size"')


def test_a_record_s_asdict_is_a_typed_mutable_copy_that_spreads_back(tmp_path):
    # `_asdict()` gives a dict with the record's fields (keys can't be added or removed), so `(**d)` is a
    # record of those fields again: typed with no annotation, read as d["name"] for the checker
    verdicts = checker(
        """\
        rec = (name="rahul", age=26)
        d = rec._asdict()
        d["age"] += 1
        back = (**d, city="Pune")
        reveal_type(back)
        """,
        tmp_path,
    )
    assert verdicts[5] == 'Type of "back" is "(name: str, age: int, city: str)"'
    rec = (name="rahul", age=26)
    d = rec._asdict()
    d["age"] += 1
    assert (**d, city="Pune") == (name="rahul", age=27, city="Pune")


def test_spreading_back_into_the_same_name_keeps_its_type(tmp_path):
    # a spread reads the nearest binding of each name before it (bindings in straight-line code), so spreading
    # back into the name it came from keeps the type, whether it spreads the record itself or its `_asdict()`
    verdicts = checker(
        """\
        r = (name="rahul", age=26)
        r = (**r)
        reveal_type(r)
        u = (name="rahul", age=26)
        u_mutable = u._asdict()
        u = (**u_mutable)
        reveal_type(u)
        v = (name="rahul", age=26)
        v_mutable = v._asdict()
        v2 = (**v_mutable)
        reveal_type(v2)
        w: (name: str, age: int) = (name="rahul", age=26)
        w_mutable = w._asdict()
        w = (**w_mutable)
        reveal_type(w)
        """,
        tmp_path,
    )
    assert verdicts[3] == 'Type of "r" is "(name: str, age: int)"'  # the record itself
    assert verdicts[7] == 'Type of "u" is "(name: str, age: int)"'  # its dict
    assert verdicts[11] == 'Type of "v2" is "(name: str, age: int)"'  # a new name
    assert verdicts[15] == 'Type of "w" is "(name: str, age: int)"'  # an annotation


def test_a_spread_is_typed_when_every_binding_that_may_reach_it_has_the_same_fields(tmp_path):
    # a name bound in a branch, a loop or `try`, rebound and read from a function, or rebound through `global`:
    # any of its bindings may be the one that ran, so the spread is typed only when they all have the same
    # fields (the field types are the checker's union). When they differ it's Unknown: annotate it
    verdicts = checker(
        """\
        import random
        c = random.random() > 0.5
        q = (name="a", age=1)
        if c:
            q = (name="b", age="x")
        e1 = (**q)
        try:
            t = (name="a", age=1)
        except Exception:
            t = (name="b", age=2, adult=False)
        e2 = (**t)
        cfg = (lr=1e-3, steps=100)
        cfg = (lr=3e-4, steps=200)
        def train():
            return (**cfg, seed=0)
        g = (name="gil", age=30)
        def bump():
            global g
            g = (name="gil", age=31)
        e3 = (**g)
        w = (a=1)
        e4 = w
        while c:
            e4 = (**w)
            w = (b=1)
        reveal_type(e1)
        reveal_type(e2)
        reveal_type(train())
        reveal_type(e3)
        reveal_type(e4)
        """,
        tmp_path,
    )
    assert verdicts[26] == 'Type of "e1" is "(name: str, age: str | int)"'  # field types: a union
    assert verdicts[27] == 'Type of "e2" is "Unknown"'  # the `except` adds a field
    assert verdicts[28] == 'Type of "train()" is "(lr: float, steps: int, seed: int)"'
    assert verdicts[29] == 'Type of "e3" is "(name: str, age: int)"'
    assert verdicts[30] == 'Type of "e4" is "(a: int) | Unknown"'  # the loop's next pass reads `w = (b=1)`


def test_replace_updates_a_record_and_a_spread_builds_a_new_one(tmp_path):
    # both copy with a field changed; _replace keeps the record's type, a spread makes whatever it's given
    r = (name="rahul", age=26)
    assert r._replace(age=r.age + 1) == (**r, age=r.age + 1) == (name="rahul", age=27)
    verdicts = checker(
        """\
        r = (name="rahul", age=26)
        r._replace(agee=27)
        r._replace(age="27")
        typo = (**r, agee=27)
        reveal_type(typo)
        retyped = (**r, age="27")
        reveal_type(retyped)
        """,
        tmp_path,
    )
    assert verdicts[2].startswith('No parameter named "agee"')  # a typo
    assert 'cannot be assigned to parameter "age" of type "int"' in verdicts[3]  # another type
    assert sorted(verdicts) == [2, 3, 5, 7]  # the spreads themselves are fine
    assert verdicts[5] == 'Type of "typo" is "(name: str, age: int, agee: int)"'  # a new field, silently
    assert verdicts[7] == 'Type of "retyped" is "(name: str, age: str)"'  # a new type, silently


type Contact = (name: str, age: int, surname: str, city: str)


def mail(to: Contact) -> str:
    return f"{to.name} {to.surname}, {to.city}"


def test_a_spread_is_checked_against_the_type_expected_where_it_stands(tmp_path):
    person, place = (name="ann", age=30), (surname="lee", city="oslo")
    c: Contact = (**person, **place)  # noqa: B008 -- see open_issues.md
    assert mail((**person, **place)) == mail(c) == "ann lee, oslo"  # noqa: B008 -- see open_issues.md
    verdicts = checker(
        """\
        type Contact = (name: str, age: int, surname: str, city: str)
        def mail(to: Contact) -> str: ...
        person = (name="ann", age=30)
        def contact_of_person() -> Contact:
            return (**person,)
        c: Contact = (**person, city="oslo")
        mail((**person, surname="lee", city="oslo", zip=1))
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [5, 6, 7]
    assert "missing fields: city, surname" in verdicts[5]  # against the return type
    assert "missing field: surname" in verdicts[6]  # against the annotation
    assert "extra field: zip" in verdicts[7]  # against the parameter


# ============================================================================
# 9. WHAT BYNAME REJECTS, AND WHY
# ============================================================================


def test_a_field_cannot_start_with_an_underscore():
    with pytest.raises(SyntaxError, match="record field '_private' cannot start with '_'"):
        transform("r = (_private=1)\n")  # NamedTuple's rule: `_` names are its own (_replace, _asdict)


def test_keys_is_reserved_because_spreads_need_it():
    with pytest.raises(SyntaxError, match="records have a keys\\(\\) method, which lets `\\*\\*record` work"):
        transform("r = (keys=1)\n")


def test_a_field_appears_once():
    with pytest.raises(SyntaxError, match="duplicate record field in \\('a', 'a'\\)"):
        transform("r = (a=1, a=2)\n")


def test_a_pattern_reads_by_name_never_by_position():
    with pytest.raises(SyntaxError, match="pattern item 'a' needs '=': write a= or a=target"):
        transform("(a, b=) = r\n")


def test_a_spread_record_takes_only_spreads_and_named_fields():
    with pytest.raises(SyntaxError, match="takes `\\*\\*record` and `name=value` items"):
        transform("r = (**u, 1)\n")


@pytest.mark.parametrize(
    "src",
    [
        'u = (name: str, age: int)(name="r", age=1)\n',
        "c = (name: str, age: int)(**u)\n",
        "c = (..., name: str)(**u)\n",
    ],
)
def test_a_record_type_cannot_be_called(src):
    # a type alias can't be called, so an inline type isn't either: build the record and annotate the name,
    # `u: (name: str, age: int) = (name="r", age=1)`, or from a dict, record(T, d)
    with pytest.raises(SyntaxError, match="can't call a record type: write the record, \\(name=...\\), annotated"):
        transform(src)


def test_instead_of_calling_a_record_type_annotate_the_name_or_use_record(tmp_path):
    u: (name: str, age: int) = (name="r", age=1)
    c: (name: str, age: int) = (**u)
    d = record((name: str, age: int), {"name": "r", "age": 1})  # an inline type stands as a value here
    assert u == c == d == (name="r", age=1)
    with pytest.raises(TypeError, match="age"):
        record((name: str, age: int), {"name": "r", "age": "one"})
    verdicts = checker(
        """\
        from byname import record
        u: (name: str, age: int) = (name="r", age=1)
        c: (name: str, age: int) = (**u)
        d = record((name: str, age: int), {"name": "r", "age": 1})
        reveal_type(d)
        e: (name: str, age: int) = (name="r")
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [5, 6]
    assert verdicts[5] == 'Type of "d" is "(name: str, age: int)"'
    assert "missing field: age" in verdicts[6]


def test_shorthand_is_for_call_sites_not_def_signatures():
    with pytest.raises(SyntaxError, match="expected default value expression"):
        to_code("def f(name=): ...\n", "x.pyn")  # it would mean "default to the outer name"


def test_destructuring_reads_attributes_so_a_dict_does_not_destructure(tmp_path):
    src = '(name=) = {"name": "rahul"}\n'
    assert checker(src, tmp_path) == {
        1: 'Cannot access attribute "name" for class "dict[str, str]"\nAttribute "name" is unknown (reportAttributeAccessIssue)'
    }
    with pytest.raises(AttributeError, match="'dict' object has no attribute 'name'"):
        exec(to_code(src, "x.pyn"), {})  # noqa: S102 -- running the rejected line


# ============================================================================
# 10. ALL TOGETHER, OVERLOADS, AND `*record`
# ============================================================================


def area(*, w: float, h: float):
    a = w * h
    perimeter = 2 * (w + h)
    return (a=, perimeter=)


def test_call_by_name_return_a_record_destructure_it():
    w, h = 3.0, 4.0
    (a=, perimeter=p) = area(w=, h=)
    assert (a, p) == (12.0, 14.0)


@overload
def lookup(key: int) -> int: ...
@overload
def lookup(key: Contact) -> str: ...
def lookup(key: int | Contact) -> int | str:
    return key if isinstance(key, int) else key.name


def test_a_spread_record_picks_the_overload_that_takes_a_record(tmp_path):
    person, place = (name="ann", age=30), (surname="lee", city="oslo")
    assert lookup((**person, **place)) == "ann"  # noqa: B008 -- see open_issues.md
    assert lookup(7) == 7
    verdicts = checker(
        """\
        from typing import overload
        type Contact = (name: str, age: int, surname: str, city: str)
        @overload
        def lookup(key: int) -> int: ...
        @overload
        def lookup(key: Contact) -> str: ...
        def lookup(key: int | Contact) -> int | str: ...
        person, place = (name="ann", age=30), (surname="lee", city="oslo")
        reveal_type(lookup((**person, **place)))
        """,
        tmp_path,
    )
    # the Contact overload; the quoted call is generated code, see open_issues.md
    assert verdicts[9].endswith('is "str"')


# Records can't be told apart at runtime, so `isinstance` can't narrow a union of them, and neither can `in`
# (open_issues.md). A field typed with a different Literal in each record can, like `kind` below
type Square = (kind: Literal["square"], side: float)
type Circle = (kind: Literal["circle"], radius: float)


@overload
def describe(shape: Square) -> int: ...
@overload
def describe(shape: Circle) -> str: ...
def describe(shape: Square | Circle) -> int | str:
    if shape.kind == "square":  # shape is Square here, and Circle after
        return round(shape.side**2)
    return f"circle of radius {shape.radius}"


def test_overloads_on_two_record_types_pick_by_shape(tmp_path):
    sq: Square = (kind="square", side=3.0)
    ci: Circle = (kind="circle", radius=2.0)
    assert describe(sq) == 9
    assert describe(ci) == "circle of radius 2.0"
    verdicts = checker(
        """\
        from typing import Literal, overload
        type Square = (kind: Literal["square"], side: float)
        type Circle = (kind: Literal["circle"], radius: float)
        @overload
        def describe(shape: Square) -> int: ...
        @overload
        def describe(shape: Circle) -> str: ...
        def describe(shape: Square | Circle) -> int | str: ...
        sq: Square = (kind="square", side=3.0)
        reveal_type(describe(sq))
        reveal_type(describe((kind="circle", radius=2.0)))
        loose = (kind="circle", radius=2.0)
        describe(loose)
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [10, 11, 13]
    assert verdicts[10].endswith('is "int"')
    assert verdicts[11].endswith('is "str"')  # a literal passed straight in is read as the parameter's type
    # a literal stored first is widened to kind: str, so it fits neither; annotate it, `loose: Circle = ...`
    assert "No overloads" in verdicts[13]


def test_a_literal_tag_narrows_a_union_of_records(tmp_path):
    shapes: list[Square | Circle] = [(kind="square", side=3.0), (kind="circle", radius=2.0)]
    assert [describe(shape) for shape in shapes] == [9, "circle of radius 2.0"]
    verdicts = checker(
        """\
        from typing import Literal
        type Square = (kind: Literal["square"], side: float)
        type Circle = (kind: Literal["circle"], radius: float)
        shapes: list[Square | Circle] = [(kind="square", side=3.0), (kind="circle", radius=2.0)]
        for shape in shapes:
            if shape.kind == "square":
                reveal_type(shape)
            else:
                reveal_type(shape)
            match shape.kind:
                case "square":
                    print(shape.side)
                case "circle":
                    print(shape.radius)
            if "side" in shape:
                print(shape.side)
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [7, 9, 16]  # nothing from the match, because each case narrows too
    assert verdicts[7].endswith("is \"(kind: Literal['square'], side: float)\"")
    assert verdicts[9].endswith("is \"(kind: Literal['circle'], radius: float)\"")
    assert 'Cannot access attribute "side"' in verdicts[16]  # `in` doesn't narrow, see open_issues.md


def pair(name: str, age: int) -> str:
    return f"{name}:{age}"


def test_a_record_spreads_into_a_call_by_name_not_position(tmp_path):
    assert pair(**(age=30, name="ann")) == "ann:30"
    verdicts = checker(
        """\
        def pair(name: str, age: int) -> str: ...
        pair(*(age=30, name="ann"))
        pair(**(age=30, name="ann"))
        """,
        tmp_path,
    )
    assert sorted(verdicts) == [2]
    assert "is not iterable" in verdicts[2]


# ============================================================================
# 11. FROM A DICT: `record(T, d)`, checked at runtime
# ============================================================================

# A dict's keys aren't known statically, so the checker rejects `(**d)` into a record type, and at runtime
# it would build whatever keys `d` has. Data loaded from a file arrives as a dict: `record(T, d)` turns it
# into a T, checking every field at runtime, and the checker types the call as T.

type ModelConfig = (n_layer: int, dropout: float)


def test_record_builds_the_record_its_literal_would():
    saved = {"n_layer": 4, "dropout": 0.2}  # say, from torch.load or json.loads
    cfg = record(ModelConfig, saved)
    assert cfg == (n_layer=4, dropout=0.2)


def test_record_is_typed_as_the_type_it_names(tmp_path):
    verdicts = checker(
        """\
        from byname import record
        type ModelConfig = (n_layer: int, dropout: float)
        cfg = record(ModelConfig, {"n_layer": 4, "dropout": 0.2})
        reveal_type(cfg)
        cfg.n_layr
        """,
        tmp_path,
    )
    assert verdicts[4] == 'Type of "cfg" is "(n_layer: int, dropout: float)"'
    assert verdicts[5].startswith('Cannot access attribute "n_layr"')


def test_record_names_every_bad_field_at_once():
    saved = {"n_layer": "4", "dropuot": 0.2}
    with pytest.raises(TypeError) as e:
        record(ModelConfig, saved)
    assert str(e.value) == (
        "ModelConfig: field 'n_layer': expected int, got str ('4'); missing field 'dropout'; unexpected field 'dropuot'"
    )


def test_a_file_saved_before_a_field_existed_gets_it_from_the_left():
    saved = {"n_layer": 4}  # written before ModelConfig had dropout
    # dict order: the left is the default, the right (what the file holds) wins
    cfg = record(ModelConfig, {"dropout": 0.0, **saved})
    assert cfg == (n_layer=4, dropout=0.0)


def test_a_field_can_be_overridden_from_the_right():
    saved = {"n_layer": 4, "dropout": 0.2}  # trained with dropout
    # the right wins: reuse a saved config with one field changed, say fine-tuning without dropout
    cfg = record(ModelConfig, {**saved, "dropout": 0.0})
    assert cfg == (n_layer=4, dropout=0.0)
